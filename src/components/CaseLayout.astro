---
/**
 * Shared shell for the app case studies: cover image, hero meta, an intro
 * paragraph, then a gallery grid. SPNKr, Tain, Keeper and Magnet all share this
 * shape, so it lives in one place rather than being pasted four times.
 *
 * The long-form bespoke case studies (Mutual, The Tree Service) deliberately do
 * NOT use this — they keep their own layouts.
 */
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  label: string;
  cover: string;
  coverAlt: string;
  meta?: { label: string; value: string }[];
  /** Optional outbound link rendered as a button under the meta row. */
  action?: { label: string; href: string };
}
const { title, description, label, cover, coverAlt, meta = [], action } = Astro.props;
---
<Base title={`${title} · Paramore.Design`} description={description}>
  <section class="project-hero">
    <div class="container">
      <a href="/work" class="btn btn--ghost" style="margin-bottom: var(--space-xl); display: inline-flex;">
        <span style="margin-right: var(--space-sm);">&larr;</span> All Projects
      </a>
      <span class="label project-hero__label" style="display: block;">{label}</span>
      <h1 class="display-lg project-hero__title">{title}</h1>
      {meta.length > 0 && (
        <div class="project-hero__meta">
          {meta.map((m) => (
            <div class="project-hero__meta-item">
              <span class="project-hero__meta-label">{m.label}</span>
              <span class="project-hero__meta-value" set:html={m.value} />
            </div>
          ))}
        </div>
      )}
      {action && (
        <a href={action.href} class="btn btn--primary" target="_blank" rel="noopener"
           style="margin-top: var(--space-xl); display: inline-flex;">{action.label}</a>
      )}
    </div>
  </section>

  <section class="section section--sm">
    <div class="container">
      <div class="case-cover">
        <img src={cover} alt={coverAlt} />
      </div>
      <div class="case-intro"><slot /></div>
    </div>
  </section>

  <slot name="gallery" />
</Base>

<style is:global>
  /* Cover sits full-width under the hero, the page's one big statement image. */
  .case-cover {
    max-width: 1100px;
    margin: 0 auto;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }
  .case-cover img { width: 100%; height: auto; display: block; }

  .case-intro {
    max-width: 68ch;
    margin: var(--space-3xl) auto 0;
    font-size: var(--text-lg);
    line-height: 1.65;
    color: var(--color-text-secondary);
  }
  .case-intro strong { color: var(--color-text-primary); font-weight: 600; }
  .case-intro p + p { margin-top: var(--space-lg); }

  /* Gallery: everything else, at equal weight, no captions competing for attention. */
  .case-gallery { padding: var(--space-4xl) 0; border-top: 1px solid var(--color-border-subtle); }
  .case-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    /* Fixed row height + row spans keeps the grid tidy. Without it, one 930x4850
       mobile screenshot stretches its whole row to 2600px. */
    grid-auto-rows: 150px;
    grid-auto-flow: dense;
    gap: var(--space-lg);
    margin-top: var(--space-2xl);
  }
  .case-grid__item {
    grid-row: span 2;
    background: var(--color-surface-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    overflow: hidden;
    transition: border-color var(--duration-normal) var(--ease-out);
  }
  .case-grid__item:hover { border-color: var(--color-accent); }
  /* Tall portrait screenshots earn a double-height cell so they stay readable. */
  .case-grid__item--tall { grid-row: span 4; }
  .case-grid__item img {
    width: 100%; height: 100%; display: block;
    object-fit: contain;
  }
  @media (max-width: 560px) {
    .case-grid { grid-template-columns: 1fr; gap: var(--space-md); grid-auto-rows: 120px; }
  }
</style>
