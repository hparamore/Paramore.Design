---
// Ported from the Claude Design canvas artboard CaseKillTheFish.dc.html. Edit the canvas, then re-port.
import BaseV2 from '../../layouts/BaseV2.astro';
---
<BaseV2 title="Kill The Fish · Paramore.Design" description="A whiteboard game from school, finally built as an app.">
  <!-- BLOCK: Case hero -->
  <section class="pd-wrap" data-screen-label="Hero">
    <div class="pd-topline">
      <a href="/work" style="text-decoration: none">← All projects</a>
      <span style="color: var(--color-accent-ink)">Personal Project // Web App</span>
    </div>
    <h1 class="pd-title" style="margin-top: 40px">Kill The Fish</h1>
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px 48px; margin: 28px 0 40px">
      <p class="pd-lede">Draw a fish. Then everyone takes a turn finishing it off. A whiteboard game from school, finally built as an app.</p>
      <a href="https://fish.paramore.design" target="_blank" rel="noopener" class="pd-btn pd-btn--primary">Play it →</a>
    </div>
    <!-- BLOCK: Meta strip -->
    <div class="pd-meta">
      <div><span class="pd-meta__label">Role</span><span class="pd-meta__value">Solo, Design &amp; Build</span></div>
      <div><span class="pd-meta__label">Platform</span><span class="pd-meta__value">Installable web app</span></div>
      <div><span class="pd-meta__label">Play</span><span class="pd-meta__value">Pass-and-play, one device</span></div>
      <div><span class="pd-meta__label">Live at</span><span class="pd-meta__value">fish.paramore.design</span></div>
    </div>
  </section>

  <!-- BLOCK: Hero image -->
  <section class="pd-wrap" style="margin-top: 48px" data-screen-label="Hero image">
    <div class="pd-frame"><img src="/assets/projects/kill-the-fish/cover.jpg" alt="Kill The Fish: draw a fish, then finish it" style="aspect-ratio: 16 / 9"></div>
  </section>

  <!-- BLOCK: Text section -->
  <section class="pd-wrap pd-section" data-screen-label="Story">
    <div class="pd-text" style="border-top: var(--pd-rule)">
      <div><div class="pd-kicker pd-kicker--accent" style="margin-bottom: 16px">Why it exists</div><h2 class="pd-h2">Draw a fish. <span class="pd-accent">Then finish it.</span></h2></div>
      <p class="pd-body" style="font-size: 17px">I played this on classroom whiteboards for years: one person draws a fish, everyone else draws a way to do it in, and it was reliably the best part of the day. I have wanted to make it an app for about as long. Now it is one: pass a single device around, draw your method, name it, and the board decides the cause of death.</p>
    </div>
  </section>

  <!-- BLOCK: Gallery (needs screenshots) -->
  <section class="pd-wrap pd-section pd-section--last" data-screen-label="Screens">
    <div class="pd-head" style="margin-bottom: 32px"><span class="pd-kicker pd-kicker--accent">Screens</span></div>
    <div class="pd-gallery pd-gallery--phones">
      <div class="pd-placeholder" style="aspect-ratio: 9 / 16">[Screen: drawing the fish]</div>
      <div class="pd-placeholder" style="aspect-ratio: 9 / 16">[Screen: drawing a method]</div>
      <div class="pd-placeholder" style="aspect-ratio: 9 / 16">[Screen: cause of death]</div>
    </div>
  </section>

  <!-- BLOCK: Next project -->
  <section class="pd-poster" data-screen-label="Next project">
    <div class="pd-poster__inner" style="padding-block: clamp(40px, 6vw, 72px)">
      <a href="/projects/game-ui" class="pd-next">
        <div><div class="pd-kicker" style="margin-bottom: 16px">Next project</div><div class="pd-poster__title" style="font-size: clamp(44px, 6vw, 88px)">Game UI Kits</div></div>
        <span class="pd-next__box" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
      </a>
    </div>
  </section>
</BaseV2>
