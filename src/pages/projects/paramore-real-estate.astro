---
import fs from 'node:fs';
import CaseLayout from '../../components/CaseLayout.astro';

/**
 * The gallery reads its own folder at build time, so adding photos means
 * dropping files into public/assets/projects/paramore-real-estate/gallery/ —
 * no code change. Sorted by filename, so a NN- prefix controls order.
 */
const DIR = 'public/assets/projects/paramore-real-estate/gallery';
const photos = fs.existsSync(DIR)
  ? fs.readdirSync(DIR).filter((f) => /\.(png|jpe?g|webp)$/i.test(f)).sort()
  : [];

const altFor = (file: string) =>
  'Paramore Real Estate, ' +
  file.replace(/^\d+[-_]?/, '').replace(/\.[^.]+$/, '').replace(/[-_]/g, ' ').trim();
---
<CaseLayout
  title="Paramore Real Estate"
  description="Rebranding my father's real estate business in Burns, Oregon — from black and red that vanished into the landscape to an orange you can spot from down the street."
  label="Family Business // Brand, Signage & Web"
  cover="/assets/projects/paramore-real-estate/cover.jpg"
  coverAlt="Paramore Real Estate branding"
  meta={[
    { label: 'Role', value: 'Brand, Signage &amp; Web' },
    { label: 'Timeline', value: '2010 – 2023' },
    { label: 'Client', value: 'Robert Paramore' },
    { label: 'Location', value: 'Burns, Oregon' },
  ]}
>
  <p>
    I designed the original logo for my father in 2010, as a design student. By 2018 the
    black-and-red brand was <strong>blending into the landscape</strong>, so we rebuilt it around
    a bright orange and a new mark. The site followed &mdash; WordPress then, a custom Wix CMS in
    2023. Now you can look down a street and tell instantly which homes are for sale.
  </p>

  {photos.length > 0 && (
    <section class="case-gallery" slot="gallery">
      <div class="container">
        <span class="label">Gallery</span>
        <div class="case-grid">
          {photos.map((f) => (
            <div class="case-grid__item">
              <img src={`/assets/projects/paramore-real-estate/gallery/${f}`} alt={altFor(f)} loading="lazy" />
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</CaseLayout>
