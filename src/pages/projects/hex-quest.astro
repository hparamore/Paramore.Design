                <source src={`${A}/loops/turn-${t.id}.mp4`} type="video/mp4">
              </video>
            </div>
            <div class="hq-turn__text">
              <span class="hq-turn__step">0{i + 1}</span>
              <h3 class="hq-turn__title">{t.title}</h3>
              <p>{t.body}</p>
              <span class="hq-turn__source">{t.source}</span>
            </div>
          </li>
        ))}
      </ol>

      <p class="hq-note">
        One more catch along the way: a single frame of the finished shape flashed before each
        turn began. It only showed up frame by frame in a slowed recording, and it's gone now.
      </p>
    </div>
  </section>

  <!-- =================== Store =================== -->
  <section class="section">
    <div class="container">
      <div class="hq-head">
        <span class="section-label">Launch // App Store &amp; Google Play</span>
