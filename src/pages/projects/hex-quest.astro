        </p>
      </div>
      <div class="hq-strip hq-strip--store" tabindex="0" role="region" aria-label="App Store screenshots, scrolls sideways">
        <img src={`${A}/store/store-01.jpg`} width="420" height="913" loading="lazy" alt="Get the full version for free: finish a game in all 9 modes during the launch event">
        <img src={`${A}/store/store-02.jpg`} width="420" height="913" loading="lazy" alt="Hex Quest, a tile matching adventure">
        <img src={`${A}/store/store-03.jpg`} width="420" height="913" loading="lazy" alt="Uh oh. Fire! Put it out fast or it spreads">
        <img src={`${A}/store/store-04.jpg`} width="420" height="913" loading="lazy" alt="Ten ways to play: every mode starts with the same idea">
        <img src={`${A}/store/store-05.jpg`} width="420" height="913" loading="lazy" alt="Now try it in color: Chroma mode">
        <img src={`${A}/store/store-06.jpg`} width="420" height="913" loading="lazy" alt="Hunt for treasure: 60 hand-built puzzles">
        <img src={`${A}/store/store-07.jpg`} width="420" height="913" loading="lazy" alt="Pick a path. Beat the boss. Expedition mode">
        <img src={`${A}/store/store-08.jpg`} width="420" height="913" loading="lazy" alt="Save the presents: Present Rush">
        <img src={`${A}/store/store-09.jpg`} width="420" height="913" loading="lazy" alt="The floor is lava: Climb mode">
        <img src={`${A}/store/store-10.jpg`} width="420" height="913" loading="lazy" alt="Bring the whole family: team leaderboards">
      </div>
    </div>
  </section>

  <!-- =================== Closing CTA =================== -->
  <section class="hq-closing">
    <div class="container">
      <h2 class="section-title">Pre-order <span class="accent">Hex Quest.</span></h2>
      <p>
        On the App Store November 25, 2026, with Android on the way. Have a product that needs
        designing and building end to end? I’d love to hear about it.
      </p>
      <div class="hq-closing__actions">
        <a href="https://hexquest.app/get" target="_blank" rel="noopener" class="btn btn--primary">
          Pre-order <span class="btn__arrow">&rarr;</span>
        </a>
        <a href="mailto:hparamore@gmail.com" class="btn btn--secondary">Email Me</a>
      </div>
    </div>
  </section>

  <!-- =================== Next Project =================== -->
  <section class="section" style="border-top: 1px solid var(--color-border);">
    <div class="container" style="display: flex; justify-content: space-between; align-items: center;">
      <span class="label">Next Project</span>
      <a href="/projects/mutual" class="btn btn--ghost" style="font-size: var(--text-xl);">
        Mutual <span class="btn__arrow">&rarr;</span>
      </a>
    </div>
  </section>
</Base>

<script>
  // ---------- Loops ----------
  // Videos have no autoplay attribute: they play only while on screen, never under
  // reduced motion (the poster stays), and each one gets its own pause button.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  const loops = Array.from(document.querySelectorAll<HTMLElement>('[data-loop]'));
  const visible = new Set<HTMLVideoElement>();
  // The viewer's choice per loop. Unset = follow the reduced-motion setting.
  const choice = new Map<HTMLVideoElement, 'on' | 'off'>();
  const wanted = (video: HTMLVideoElement) => {
    const c = choice.get(video);
    return c ? c === 'on' : !reduceMotion.matches;
  };

  const sync = (video: HTMLVideoElement) => {
    const shouldPlay = visible.has(video) && wanted(video);
    if (shouldPlay && video.paused) video.play().catch(() => { /* autoplay blocked: poster stays */ });
    if (!shouldPlay && !video.paused) video.pause();
  };

  loops.forEach((figure) => {
    const video = figure.querySelector('video');
    const frame = figure.querySelector('.hq-loop__frame');
    if (!video || !frame) return;
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'hq-loop__toggle';
    const label = () => {
      const on = wanted(video);
      button.setAttribute('aria-label', on ? 'Pause loop' : 'Play loop');
      button.dataset.state = on ? 'playing' : 'paused';
    };
    button.innerHTML =
      '<svg class="hq-i-pause" aria-hidden="true" width="12" height="12" viewBox="0 0 24 24"><rect x="5" y="4" width="5" height="16" fill="currentColor"/><rect x="14" y="4" width="5" height="16" fill="currentColor"/></svg>' +
      '<svg class="hq-i-play" aria-hidden="true" width="12" height="12" viewBox="0 0 24 24"><path d="M7 4.5v15l12.5-7.5z" fill="currentColor"/></svg>';
    // An explicit tap wins over reduced motion, for this one loop only.
    button.addEventListener('click', () => {
      choice.set(video, wanted(video) ? 'off' : 'on');
      sync(video);
      label();
    });
    label();
    frame.appendChild(button);
    reduceMotion.addEventListener('change', () => { label(); sync(video); });
  });

  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => {
      const video = e.target as HTMLVideoElement;
      if (e.isIntersecting) visible.add(video); else visible.delete(video);
      sync(video);
    });
  }, { rootMargin: '120px 0px' });
  document.querySelectorAll<HTMLVideoElement>('[data-loop] video').forEach((v) => io.observe(v));

  // ---------- Music mixer ----------
  // Ported from hexquest.app (site/home.js): every world version of a song plays from the
  // same start sample, and tapping a world crossfades between them. Three songs here, at a
  // lower bitrate than the game site, and nothing loads until Play.
  const mixer = document.querySelector<HTMLElement>('[data-mixer]');
  if (mixer) {
    const AUDIO = '/assets/projects/hex-quest/audio';
    const WORLDS = ['honey', 'forest', 'ice', 'underwater', 'volcano', 'chiptune', 'pirate', 'christmas'];
    const WORLD_NAMES: Record<string, string> = {
      honey: 'Honey', forest: 'Forest', ice: 'Ice', underwater: 'Underwater',
      volcano: 'Volcano', chiptune: 'Chroma', pirate: 'Pirate', christmas: 'Christmas',
    };
    const SONGS: [string, string][] = [['hive', 'Hive'], ['nightdrive', 'Night Drive'], ['bramble', 'Bramble']];

    const titleEl = mixer.querySelector<HTMLElement>('[data-song-title]')!;
    const playButton = mixer.querySelector<HTMLButtonElement>('[data-play]')!;
    const playText = mixer.querySelector<HTMLElement>('[data-play-text]')!;
    const progressEl = mixer.querySelector<HTMLElement>('[data-progress]')!;
    const statusEl = mixer.querySelector<HTMLElement>('[data-status]')!;
    const worldButtons = Array.from(mixer.querySelectorAll<HTMLButtonElement>('[data-world]'));

    type Voice = { src: AudioBufferSourceNode; gain: GainNode; world: string };
    const state = { song: 'hive', world: 'honey', playing: false, loading: false, error: '' };
    let ctx: AudioContext | null = null;
    let master: GainNode | null = null;
    let voices: Voice[] = [];
    let voicesSong: string | null = null;
    let t0 = 0, len = 1;
    let loaded: { song: string; buffers: AudioBuffer[] } | null = null; // only the current song, to save memory
    let request = 0;                          // bumps on every load, so a slow load can't start a song you've left
    let fetching: AbortController | null = null;

    const songTitle = () => (SONGS.find(([id]) => id === state.song) || SONGS[0])[1];

    function render() {
      titleEl.textContent = songTitle();
      playButton.dataset.state = state.playing ? 'playing' : 'paused';
      playButton.setAttribute('aria-label', state.playing ? 'Pause the music' : 'Play the music');
      playText.textContent = state.loading ? 'Loading' : state.playing ? 'Pause' : 'Play';
      statusEl.textContent = state.error ? state.error
        : state.loading ? 'Loading 8 versions of the song…'
        : state.playing ? `Now playing: ${songTitle()}, ${WORLD_NAMES[state.world]} version`
        : 'Press play, then tap a world.';
      worldButtons.forEach((b) => {
        const on = b.dataset.world === state.world;
        b.setAttribute('aria-pressed', on ? 'true' : 'false');
        b.setAttribute('aria-label', `${WORLD_NAMES[b.dataset.world!]} version${on ? ', selected' : ''}`);
      });
    }

    async function load(song: string) {
      if (loaded && loaded.song === song) return loaded.buffers;
      loaded = null;
      if (fetching) fetching.abort();
      const controller = fetching = new AbortController();
      const responses = await Promise.all(WORLDS.map(async (w) => {
        const url = `${AUDIO}/${song}-${w}.mp4`;
        const res = await fetch(url, { signal: controller.signal });
        if (!res.ok) throw new Error(`${res.status}`);
        return res.arrayBuffer();
      }));
      // Decode one at a time to keep the memory peak down.
      const buffers: AudioBuffer[] = [];
      for (const data of responses) buffers.push(await ctx!.decodeAudioData(data));
      if (controller.signal.aborted) throw new DOMException('Superseded', 'AbortError');
      if (fetching === controller) fetching = null;
      loaded = { song, buffers };
      return buffers;
    }

    function stopVoices() {
      voices.forEach((v) => {
        try { v.src.stop(); } catch { /* already stopped */ }
        v.src.disconnect();
        v.gain.disconnect();
      });
      voices = [];
      voicesSong = null;
    }

    async function startSong(song: string) {
      const mine = ++request;
      state.loading = true; state.error = '';
      stopVoices();
      render();
      try {
        const buffers = await load(song);
        if (mine !== request) return;
        // Every world version starts on the same sample, so they stay locked together.
        const at = ctx!.currentTime + 0.12;
        voices = buffers.map((buffer, i) => {
          const src = ctx!.createBufferSource();
          src.buffer = buffer;
          src.loop = true;
          const gain = ctx!.createGain();
          gain.gain.value = WORLDS[i] === state.world ? 1 : 0;
          src.connect(gain).connect(master!);
          src.start(at);
          return { src, gain, world: WORLDS[i] };
        });
        voicesSong = song;
        t0 = at;
        len = buffers[0].duration;
        state.loading = false; state.playing = true;
      } catch (e) {
        const err = e as Error;
        if (mine !== request || err.name === 'AbortError') return;
        state.loading = false; state.playing = false;
        state.error = 'Couldn’t load the music. Try again in a moment.';
      }
      render();
    }

    // Equal-power crossfade over 1 s, like the mode cards in the app.
    function fadeTo(world: string) {
      state.world = world;
      render();
      if (!ctx || !voices.length) return;
      const now = ctx.currentTime, dur = 1.0, n = 32;
      voices.forEach((v) => {
        const g = v.gain.gain, from = g.value, to = v.world === world ? 1 : 0;
        if (g.cancelAndHoldAtTime) g.cancelAndHoldAtTime(now); else g.cancelScheduledValues(now);
        const curve = new Float32Array(n);
        for (let i = 0; i < n; i++) {
          const t = i / (n - 1);
          curve[i] = to ? from + (1 - from) * Math.sin((t * Math.PI) / 2) : from * Math.cos((t * Math.PI) / 2);
        }
        g.setValueCurveAtTime(curve, now + 0.01, dur);
      });
    }

    function updateProgress() {
      if (!ctx || !state.playing) return;
      const p = Math.max(0, ((ctx.currentTime - t0) % len) / len);
      progressEl.style.width = `${(p * 100).toFixed(1)}%`;
    }

    async function toggle() {
      if (state.loading) return;
      if (!ctx) {
        const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        if (!AC) { state.error = 'This browser can’t play the mixer.'; render(); return; }
        ctx = new AC();
        master = ctx.createGain();
        master.gain.value = 0.85;
        master.connect(ctx.destination);
        setInterval(updateProgress, 120);
      }
      if (state.playing) {
        await ctx.suspend();
        state.playing = false;
        render();
        return;
      }
      if (ctx.state === 'suspended') await ctx.resume();
      if (voices.length && voicesSong === state.song) {
        state.playing = true;
        render();
      } else {
        await startSong(state.song);
      }
    }

    function stepSong(dir: number) {
      const ids = SONGS.map(([id]) => id);
      const i = ids.indexOf(state.song);
      state.song = ids[(i + dir + ids.length) % ids.length];
      state.error = '';
      if (state.playing || state.loading) {
        startSong(state.song);
      } else {
        // Paused: drop the old song now; Play starts the new one.
        request++;
        if (fetching) { fetching.abort(); fetching = null; }
        stopVoices();
        progressEl.style.width = '0%';
        render();
      }
    }

    mixer.querySelector('[data-song-prev]')!.addEventListener('click', () => stepSong(-1));
    mixer.querySelector('[data-song-next]')!.addEventListener('click', () => stepSong(1));
    playButton.addEventListener('click', toggle);
    worldButtons.forEach((b) => b.addEventListener('click', () => fadeTo(b.dataset.world!)));
    render();
  }
</script>
