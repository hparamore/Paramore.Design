---
import Base from '../../layouts/Base.astro';
// Large page CSS lives in its own file so `astro dev` hot-reloads it (see CLAUDE.md → Conventions).
import '../../styles/projects/hex-quest.css';

const A = '/assets/projects/hex-quest';

// Gameplay loops: real recordings of the shipping game, cropped to the board and tray.
// Captions use the game's own Level Details copy where there is one.
const loops = [
  { id: 'honey', mode: 'Honey', caption: 'Clear lines, stack combos. Double, then Hat Trick.' },
  { id: 'volcano', mode: 'Volcano', caption: 'Lava splashes into empty cells, then hardens to stone.' },
  { id: 'underwater', mode: 'Underwater', caption: 'The current pushes blocks as far as they can go.' },
  { id: 'chroma', mode: 'Chroma', caption: 'Complete lines of one color. Don’t mix them.' },
  { id: 'ice', mode: 'Ice', caption: 'Ice spreads to the blocks it touches. Heaters melt it.' },
  { id: 'climb', mode: 'Climb', caption: 'The floor is lava, and the board never stops sinking.' },
];

const screens = [
  { id: 'honey', alt: 'Honey mode: a honeycomb board, level 6, x6 score' },
  { id: 'forest', alt: 'Forest mode: fire spreading through log tiles' },
  { id: 'ice', alt: 'Ice mode: a pale blue board with frozen tiles' },
  { id: 'underwater', alt: 'Underwater mode: deep blue board under light rays' },
  { id: 'volcano', alt: 'Volcano mode: grey stone tiles on a glowing red board' },
  { id: 'chroma', alt: 'Chroma mode: red, blue and green tiles on a neon grid' },
  { id: 'treasure', alt: 'Treasure Hunt: a dotted trail across the board toward an X' },
  { id: 'expedition', alt: 'Expedition: a branching map of stops up to a boss' },
  { id: 'climb', alt: 'Climb: a tall board sinking into lava' },
  { id: 'present', alt: 'Present Rush: a Christmas tree of peppermint tiles' },
  { id: 'leaderboard', alt: 'The team leaderboard, with weekly winners and a top ten' },
  { id: 'punch', alt: 'Board clear: the whole board lit up for a big score' },
];

// Piece rotation, in the order it was built.
const turns = [
  {
    id: '1-instant',
    title: 'Instant',
    body: 'The first version just swapped in the turned shape. It worked, but the piece jumped. Nothing showed your eye how it got there.',
    source: 'Recreated from frames of the final build',
    alt: 'A four-tile piece snapping to its new angle with no animation',
  },
  {
    id: '2-flip',
    title: 'Tiles on the move',
    body: 'Then the tiles animated to their new spots one by one and slid through each other. A later pass wound up the wrong way, swung wide and left ghost tiles fading in their old spots.',
    source: 'My slowed-down screen recording, Oct 28',
    alt: 'A three-tile piece turning: its x3 label flips upside down while faded ghost tiles linger behind',
  },
  {
    id: '3-spin',
    title: 'One picture',
    body: 'Turning the whole piece as one image kept the tiles together, but the light turned with it. Every highlight and shadow spun round, as if the sun had moved.',
    source: 'Same recording',
    alt: 'A seven-tile flower piece spinning as one image, its highlights rotating with it',
  },
  {
    id: '4-slow',
    title: 'Turn, then crossfade',
    body: 'The fix: draw the old and new shapes together. Both turn around one pivot that drifts between their centers, and a correctly lit copy fades in over the middle of the turn.',
    source: 'Slowed down so you can see the swap',
    alt: 'A three-tile piece turning slowly while an upright, correctly lit copy fades in over it',
  },
  {
    id: '5-final',
    title: 'Shipped',
    body: 'One ease-in-out turn in 0.24 seconds. The same turn plays for a tap in the tray, a second finger while dragging and Hold to Rotate, on iOS and Android.',
    source: 'The final build, full speed',
    alt: 'A four-tile piece turning smoothly to its new angle at full speed',
  },
];

// The music mixer's worlds. `chiptune` is the file name for Chroma's arrangement.
const worlds = [
  { id: 'honey', name: 'Honey', tile: 'honey' },
  { id: 'forest', name: 'Forest', tile: 'forest' },
  { id: 'ice', name: 'Ice', tile: 'ice' },
  { id: 'underwater', name: 'Underwater', tile: 'underwater' },
  { id: 'volcano', name: 'Volcano', tile: 'volcano' },
  { id: 'chiptune', name: 'Chroma', tile: 'chiptune' },
  { id: 'pirate', name: 'Pirate', tile: 'pirate-world' },
  { id: 'christmas', name: 'Christmas', tile: 'peppermint' },
];
---

<Base
  title={"Hex Quest · Paramore.Design"}
  description={"Hex Quest, a hex tile-matching adventure for iPhone, iPad and Android. Nine modes, a soundtrack that changes with every world, and live leaderboards, designed and built end to end by Hunter Paramore."}
>
  <!-- =================== Project Hero =================== -->
  <section class="project-hero hq-hero">
    <div class="container">
      <a href="/work" class="btn btn--ghost" style="margin-bottom: var(--space-xl); display: inline-flex;">
        <span style="margin-right: var(--space-sm);">&larr;</span> All Projects
      </a>
      <span class="label project-hero__label" style="display: block;">Mobile Game // iOS &amp; Android</span>
      <h1 class="display-lg project-hero__title">Hex Quest</h1>
      <p class="hq-hero__lede">
        A hex tile-matching adventure. Nine ways to play, global and team leaderboards, and a
        soundtrack that changes with every world. <strong>I designed and built all of it.</strong>
      </p>
      <div class="hq-hero__actions">
        <a href="https://hexquest.app/get" target="_blank" rel="noopener" class="btn btn--primary">
          Pre-order on the App Store <span class="btn__arrow">&rarr;</span>
        </a>
        <a href="https://hexquest.app" target="_blank" rel="noopener" class="btn btn--secondary">hexquest.app</a>
      </div>
      <div class="project-hero__meta">
        <div class="project-hero__meta-item">
          <span class="project-hero__meta-label">Role</span>
          <span class="project-hero__meta-value">Solo designer &amp; developer</span>
        </div>
        <div class="project-hero__meta-item">
          <span class="project-hero__meta-label">Platforms</span>
          <span class="project-hero__meta-value">iPhone · iPad · Android</span>
        </div>
        <div class="project-hero__meta-item">
          <span class="project-hero__meta-label">Stack</span>
          <span class="project-hero__meta-value">SwiftUI · Jetpack Compose · Cloudflare Workers</span>
        </div>
        <div class="project-hero__meta-item">
          <span class="project-hero__meta-label">Launch</span>
          <span class="project-hero__meta-value">App Store, Nov 25, 2026</span>
        </div>
      </div>
    </div>
  </section>

  <!-- =================== Hero image =================== -->
  <div class="container">
    <img
      class="hq-hero__image"
      src={`${A}/hero.jpg`}
      width="1800" height="772"
      alt="The Hex Quest logo between four phones showing Honey, Forest, Chroma and the Treasure Hunt map"
      fetchpriority="high"
    >
    <p class="hq-lede">
      Hex Quest started as Honey Hive, a single honeycomb board. It grew into a full game:
      nine modes, songs re-voiced for every world, one engine running on iOS and Android, live
      leaderboards, and the website that sells it. After rounds of testing with a big group of
      beta testers on TestFlight and Google Play, it lands on the App Store November 25.
    </p>
  </div>

  <!-- =================== Numbers =================== -->
  <section class="section hq-stats-section">
    <div class="container">
      <div class="hq-stats">
        <div>
          <div class="hq-stat__value">9</div>
          <div class="hq-stat__label">Game modes, plus a seasonal Present Rush.</div>
        </div>
        <div>
          <div class="hq-stat__value">8</div>
          <div class="hq-stat__label">Songs that change instruments with the world.</div>
        </div>
        <div>
          <div class="hq-stat__value">60</div>
          <div class="hq-stat__label">Hand-built Treasure Hunt puzzles.</div>
        </div>
        <div>
          <div class="hq-stat__value">1</div>
          <div class="hq-stat__label">Shared game engine behind iOS and Android.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- =================== What I made =================== -->
  <section class="section">
    <div class="container">
      <div class="hq-head">
        <span class="section-label">Designed &amp; built by Hunter</span>
        <h2 class="section-title">Every piece, <span class="accent">one person.</span></h2>
      </div>
      <ul class="hq-made">
        <li>
          <span class="hq-made__name">Worlds &amp; tiles</span>
          <span class="hq-made__desc">Nine worlds, each with its own tiles, hazards and rules. Smoke that rolls over the board, fire that spreads, ice that freezes its neighbors, currents, lava.</span>
        </li>
        <li>
          <span class="hq-made__name">Every screen</span>
          <span class="hq-made__desc">Menus, mode cards, game over, the punch card, leaderboards and settings, laid out for iPhone, iPad and the folding iPhone Duo.</span>
        </li>
        <li>
          <span class="hq-made__name">Music direction</span>
          <span class="hq-made__desc">Eight songs written so the instruments can change without changing the tune. Every world gets its own arrangement.</span>
        </li>
        <li>
          <span class="hq-made__name">The engine</span>
          <span class="hq-made__desc">The rules live in one Swift engine. The iPhone app runs it in SwiftUI, and the Android app calls the same code from Jetpack Compose.</span>
        </li>
        <li>
          <span class="hq-made__name">Servers</span>
          <span class="hq-made__desc">Global and team leaderboards and live content, running on Cloudflare Workers.</span>
        </li>
        <li>
          <span class="hq-made__name">Website &amp; store</span>
          <span class="hq-made__desc">hexquest.app and the App Store listing, screenshots included.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- =================== Modes =================== -->
  <section class="section">
    <div class="container">
      <div class="hq-head">
        <span class="section-label">The game</span>
        <h2 class="section-title">Nine ways <span class="accent">to play.</span></h2>
        <p class="section-sub">Every mode starts from the same idea: drop pieces, clear lines. Then each one finds a new way to mess with you.</p>
      </div>

      <div class="hq-loops">
        {loops.map((l) => (
