      <div class="hq-strip" tabindex="0" role="region" aria-label="Screenshots of every mode, scrolls sideways">
        {screens.map((s) => (
          <img src={`${A}/screens/${s.id}.jpg`} width="480" height="1043" alt={s.alt} loading="lazy">
