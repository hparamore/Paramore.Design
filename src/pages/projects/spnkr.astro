---
import CaseLayout from '../../components/CaseLayout.astro';
---
<CaseLayout
  title="SPNKr"
  description="Replacing a $30/month game server rental with a spare PC, then redesigning the dashboard out of default AI output."
  label="Personal Work // Self-Hosted Tooling"
  cover="/assets/projects/spnkr/cover.png"
  coverAlt="SPNKr, game server control"
  meta={[
    { label: 'Role', value: 'Solo, Design &amp; Build' },
    { label: 'Discipline', value: 'Product Design · Art Direction · Frontend' },
    { label: 'Stack', value: 'Node · Socket.IO · SQLite · Vanilla JS' },
    { label: 'Status', value: 'Running in production, at home' },
  ]}
  action={{ label: 'View on GitHub', href: 'https://github.com/hparamore/SPNKr-gameserver-selfhosted-dashboard' }}
>
  <p>
    Replaced a <strong>$30/month</strong> game server rental with a spare PC running eight
    games, controllable from Discord. Then redesigned the dashboard out of default AI
    output &mdash; warm gunmetal instead of consumer blue-black, borders doing the work
    instead of shadows &mdash; with the art direction spec enforced by a script that checks
    sixteen rules against the code on every run.
  </p>

  <p>
    <a href="https://github.com/hparamore/SPNKr-gameserver-selfhosted-dashboard"
       class="btn btn--primary" target="_blank" rel="noopener"
       style="display: inline-flex; margin-top: var(--space-md);">Download for free on GitHub</a>
  </p>

  <section class="case-gallery" slot="gallery">
    <div class="container">
      <span class="label">Gallery</span>
      <div class="case-grid">
          <div class="case-grid__item">
            <img src="/assets/projects/spnkr/00-before-original-design.png" alt="SPNKr, before original design" loading="lazy">
          </div>
          <div class="case-grid__item">
            <img src="/assets/projects/spnkr/01-dashboard.png" alt="SPNKr, dashboard" loading="lazy">
          </div>
          <div class="case-grid__item">
            <img src="/assets/projects/spnkr/02-dashboard-compact.png" alt="SPNKr, dashboard compact" loading="lazy">
          </div>
          <div class="case-grid__item">
            <img src="/assets/projects/spnkr/03-configure.png" alt="SPNKr, configure" loading="lazy">
          </div>
          <div class="case-grid__item">
            <img src="/assets/projects/spnkr/04-port-forwarding.png" alt="SPNKr, port forwarding" loading="lazy">
          </div>
          <div class="case-grid__item">
            <img src="/assets/projects/spnkr/05-setup-agent-prompts.png" alt="SPNKr, setup agent prompts" loading="lazy">
          </div>
          <div class="case-grid__item">
            <img src="/assets/projects/spnkr/07-image-cropper.png" alt="SPNKr, image cropper" loading="lazy">
          </div>
          <div class="case-grid__item">
            <img src="/assets/projects/spnkr/08-states-in-flight.png" alt="SPNKr, states in flight" loading="lazy">
          </div>
          <div class="case-grid__item case-grid__item--tall">
            <img src="/assets/projects/spnkr/11-mobile.png" alt="SPNKr, mobile" loading="lazy">
          </div>
          <div class="case-grid__item case-grid__item--tall">
            <img src="/assets/projects/spnkr/14-compact-mobile.png" alt="SPNKr, compact mobile" loading="lazy">
          </div>
          <div class="case-grid__item">
            <img src="/assets/projects/spnkr/15-compact-event-log.png" alt="SPNKr, compact event log" loading="lazy">
          </div>
          <div class="case-grid__item">
            <img src="/assets/projects/spnkr/photo-IMG_0550.jpg" alt="SPNKr, photo 0550" loading="lazy">
          </div>
          <div class="case-grid__item">
            <img src="/assets/projects/spnkr/photo-IMG_0553.jpg" alt="SPNKr, photo 0553" loading="lazy">
          </div>
          <div class="case-grid__item">
            <img src="/assets/projects/spnkr/photo-IMG_0555.jpg" alt="SPNKr, photo 0555" loading="lazy">
          </div>
          <div class="case-grid__item">
            <img src="/assets/projects/spnkr/photo-IMG_0556.jpg" alt="SPNKr, photo 0556" loading="lazy">
          </div>
          <div class="case-grid__item">
            <img src="/assets/projects/spnkr/photo-IMG_0557.jpg" alt="SPNKr, photo 0557" loading="lazy">
          </div>
      </div>
    </div>
  </section>
</CaseLayout>
