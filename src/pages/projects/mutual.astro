---
// Ported from the Claude Design canvas artboard CaseMutual.dc.html. Edit the canvas, then re-port.
import BaseV2 from '../../layouts/BaseV2.astro';
import shots from '../../data/mutual-shots.json';
const featuredCount = shots.filter((s) => s.featured).length;
---
<BaseV2 title="Mutual · Paramore.Design" description="Ten years as the sole founding designer of Mutual, the #1 LDS dating app.">
  <!-- BLOCK: Case hero -->
  <section class="pd-wrap" data-screen-label="Hero">
    <div class="pd-topline">
      <a href="/work" style="text-decoration: none">← All projects</a>
      <span class="pd-kicker--accent" style="color: var(--color-accent-ink)">Founder // 10 Years // Solo Designer</span>
    </div>
    <h1 class="pd-title" style="margin-top: 40px">Mutual</h1>
    <p class="pd-lede" style="margin: 28px 0 40px">Ten years as the sole founding designer of Mutual, the #1 LDS dating app, responsible for 40,000+ marriages and counting.</p>
    <!-- BLOCK: Meta strip -->
    <div class="pd-meta">
      <div><span class="pd-meta__label">Role</span><span class="pd-meta__value">Co-Founder · Sole Founding Designer</span></div>
      <div><span class="pd-meta__label">Timeline</span><span class="pd-meta__value">2015 – 2026 · Ten Years</span></div>
      <div><span class="pd-meta__label">Platform</span><span class="pd-meta__value">iOS, Android, Web</span></div>
      <div><span class="pd-meta__label">Scope</span><span class="pd-meta__value">Product, Brand, UI, Research</span></div>
    </div>
  </section>

  <!-- BLOCK: TL;DR (context / role / outcome) -->
  <section class="pd-wrap" style="margin-top: 40px" data-screen-label="TL;DR">
    <div class="pd-tldr">
      <div><span class="pd-tldr__label">Context</span><p class="pd-tldr__text">A dating app for LDS singles where the product <em>is</em> other people, and half-finished, unverified profiles made it worse for everyone.</p></div>
      <div><span class="pd-tldr__label">My role</span><p class="pd-tldr__text">Co-founder and the only designer for ten years: UI, brand, design system, and research, across iOS, Android and web.</p></div>
      <div><span class="pd-tldr__label">Outcome</span><p class="pd-tldr__text">The #1 LDS dating app and 40,000+ marriages. A rebuilt onboarding where 97% finished their whole profile in testing.</p></div>
    </div>
  </section>

  <!-- BLOCK: Hero image -->
  <section class="pd-wrap" style="margin-top: 48px" data-screen-label="Hero image">
    <div class="pd-frame"><img src="/assets/projects/mutual/MutualHero-wide.jpg" alt="Mutual case study hero composition" style="aspect-ratio: 2564 / 1275"></div>
  </section>

  <!-- BLOCK: Role & boundaries -->
  <section class="pd-wrap pd-section" data-screen-label="Role and boundaries">
    <div class="pd-head" style="margin-bottom: 24px"><span class="pd-kicker pd-kicker--accent">Role &amp; boundaries</span></div>
    <div class="pd-owners">
      <div>
        <span class="pd-kicker" style="color: var(--color-text)">I owned</span>
        <ul>
          <li>Every product surface, end to end, on iOS, Android and web</li>
          <li>Brand identity, and later a second brand for Ark</li>
          <li>The design system: three brands, six themes, semantic tokens</li>
          <li>Product and user research, including the onboarding tests</li>
          <li>A large part of product direction and strategy</li>
        </ul>
      </div>
      <div>
        <span class="pd-kicker" style="color: var(--color-text)">Others owned</span>
        <ul>
          <li>[Engineering: who built and shipped the apps]</li>
          <li>[Co-founders: business, growth, operations]</li>
          <li>[Anyone who helped run the in-person research]</li>
        </ul>
      </div>
      <p class="pd-owners__foot">Part-time from day one, full-time since 2021. Design direction for a company of about 30 across two shipping products. [One line on how you worked with engineering, e.g. how handoff or pairing ran.]</p>
    </div>
  </section>

  <!-- BLOCK: Text section -->
  <section class="pd-wrap pd-section" data-screen-label="Overview">
    <div class="pd-text" style="border-top: var(--pd-rule)">
      <div><div class="pd-kicker pd-kicker--accent" style="margin-bottom: 16px">Overview</div><h2 class="pd-h2">Ten years. One designer.</h2></div>
      <div class="pd-body" style="font-size: 17px">
        <p>Co-founder and sole founding designer of Mutual, the #1 LDS dating app in the world. Grew it from a scrappy startup into a multi-million-dollar business. Part-time from day one, full-time since 2021.</p>
        <p>Ten years as the only designer in the company. Owned every surface end-to-end: UI, product and user research, design system, brand identity. Greatly involved in product direction, strategy, and success.</p>
        <p>Responsible for 40,000+ marriages and counting. Humbling, and fills me with joy.</p>
      </div>
    </div>
  </section>

  <!-- BLOCK: Stats band -->
  <section class="pd-wrap" style="margin-top: 48px" data-screen-label="Stats">
    <div class="pd-cells">
      <div><div class="pd-stat__value">10 yrs</div><div class="pd-stat__label">Sole founding designer, end-to-end ownership</div></div>
      <div><div class="pd-stat__value pd-accent">40K+</div><div class="pd-stat__label">Marriages from Mutual users, and counting</div></div>
      <div><div class="pd-stat__value">#1</div><div class="pd-stat__label">LDS dating app worldwide</div></div>
    </div>
  </section>

  <!-- BLOCK: Text section -->
  <section class="pd-wrap pd-section" data-screen-label="Onboarding research">
    <div class="pd-text" style="border-top: var(--pd-rule)">
      <div><div class="pd-kicker pd-kicker--accent" style="margin-bottom: 16px">Onboarding research</div><h2 class="pd-h2">Giving people <span class="pd-accent">an exit.</span></h2></div>
      <div class="pd-body" style="font-size: 17px">
        <p>Signing up meant one long form, then getting bounced around the app to add photos. Plenty of people never finished. That is a real problem when the product <em>is</em> other people: a half-empty profile is a worse experience for everyone who sees it, and an unverified one gives nobody peace of mind.</p>
        <p>The risk in asking for more was form fatigue. Ask for too much, get less.</p>
      </div>
    </div>
  </section>

  <!-- BLOCK: Key decisions -->
  <section class="pd-wrap" style="margin-top: 48px" data-screen-label="Decisions">
    <div class="pd-head" style="margin-bottom: 0"><span class="pd-kicker pd-kicker--accent">Key decisions</span><span class="pd-kicker">Onboarding</span></div>
    <div class="pd-decisions" style="border-top: 0">
      <div class="pd-decision">
        <h3 class="pd-decision__title">A stepped flow, not one long form</h3>
        <dl>
          <dt>Options</dt><dd>Keep the single long form, then send people around the app to add photos; or break signup into steps with a progress timeline across the top.</dd>
          <dt>Why</dt><dd>Plenty of people never finished the long form, and a half-empty profile is a worse experience for everyone who sees it.</dd>
          <dt class="is-tradeoff">Trade-off</dt><dd class="is-tradeoff">More screens to get through, and asking for more risks form fatigue: ask for too much, get less.</dd>
        </dl>
      </div>
      <div class="pd-decision">
        <h3 class="pd-decision__title">Make the exit deliberate and visible</h3>
        <dl>
          <dt>Options</dt><dd>Require every field before entering the app; or, once the required basics are in, show a button beside the timeline that skips straight to the app.</dd>
          <dt>Why</dt><dd>[Why a visible exit, in your words.] The exit is deliberate, and impossible to miss.</dd>
          <dt class="is-tradeoff">Trade-off</dt><dd class="is-tradeoff">[Draft: the risk that people skip and leave thin profiles.] In testing, almost nobody took it: 97% finished the whole profile.</dd>
        </dl>
      </div>
      <div class="pd-decision">
        <h3 class="pd-decision__title">Test two flows in person</h3>
        <dl>
          <dt>Options</dt><dd>[What else was considered: remote tests, an A/B test in production, shipping one flow and watching analytics.]</dd>
          <dt>Why</dt><dd>We took over a local waffle place and traded free waffles for time with the app. My part was testing two onboarding flows against each other, both built from research into how other apps handle the same moment.</dd>
          <dt class="is-tradeoff">Trade-off</dt><dd class="is-tradeoff">[What you gave up: sample size, one location, a self-selected crowd.]</dd>
        </dl>
      </div>
      <div class="pd-decision">
        <h3 class="pd-decision__title">Fold verification into signup</h3>
        <dl>
          <dt>Options</dt><dd>Leave verification as a separate step people find later; or make it part of the onboarding flow.</dd>
          <dt>Why</dt><dd>An unverified profile gives nobody peace of mind. About 80% completed verification once it was in the flow.</dd>
          <dt class="is-tradeoff">Trade-off</dt><dd class="is-tradeoff">[One more step at the most fragile moment of signup; say how you kept it from costing completions.]</dd>
        </dl>
      </div>
    </div>
  </section>

  <!-- BLOCK: Stats band (pair) -->
  <section class="pd-wrap" style="margin-top: 48px" data-screen-label="Results">
    <div class="pd-cells">
      <div><div class="pd-stat__value pd-accent">97%</div><div class="pd-stat__label">Finished the whole profile instead of skipping, in testing</div></div>
      <div><div class="pd-stat__value">~80%</div><div class="pd-stat__label">Completed profile verification, once it was folded into the flow</div></div>
    </div>
  </section>

  <!-- BLOCK: Gallery (phones) -->
  <section class="pd-wrap pd-section" data-screen-label="Concept to Ship">
    <div class="pd-text" style="border-top: var(--pd-rule)">
      <div><div class="pd-kicker pd-kicker--accent" style="margin-bottom: 16px">The last 18 months</div><h2 class="pd-h2">Concept <span class="pd-accent">to</span> ship.</h2></div>
      <div class="pd-body" style="font-size: 17px">
        <p>A slice of the last year and a half of work at Mutual: feature concepts, A/B tests, prototypes, and shipped releases. <strong>Each thumbnail represents a complete Figma page</strong> behind it: dev-ready flows, design system updates, and the supporting work that made it real.</p>
        <p>Most shipped. Some are still v1s waiting on a v2. A few stayed prototypes that didn’t make it past testing. Each one started as an idea I shaped into something concrete enough to put in front of people and talk about.</p>
      </div>
    </div>
    <div class="pd-gallery pd-gallery--phones mutual-gallery" data-gallery style="margin-top: 48px" aria-live="polite">
      {shots.map((s) => (
        <figure style="margin: 0" class={s.featured ? 'is-featured' : undefined}>
          <div class="pd-frame pd-frame--contain" style="aspect-ratio: 4 / 5"><img src={s.src} alt={s.title} loading="lazy"></div>
          <figcaption class="pd-figcap">{s.title}</figcaption>
        </figure>
      ))}
    </div>
    <div style="margin-top: 32px; display: flex; align-items: center; gap: 16px; flex-wrap: wrap">
      <button type="button" class="pd-btn" data-toggle aria-expanded="false">Show all {shots.length} screens</button>
      <span class="pd-kicker" data-count>{featuredCount} of {shots.length} screens</span>
    </div>
  </section>

  <!-- BLOCK: Looking back -->
  <section class="pd-wrap pd-section" data-screen-label="Looking back">
    <div class="pd-lookback">
      <div><div class="pd-kicker" style="margin-bottom: 12px">Looking back</div><h2 class="pd-h3" style="color: var(--color-bg)">What I’d do differently</h2></div>
      <p>[One honest answer: a decision above you’d now make the other way, or something you’d measure earlier. This is the question an interviewer will ask; answer it first.]</p>
    </div>
  </section>

  <!-- BLOCK: Closing CTA -->
  <section class="pd-wrap pd-section pd-section--last" data-screen-label="Closing">
    <div class="pd-quote">
      <p class="pd-quote__text">And that’s <span class="pd-accent">just</span> the last 18 months.</p>
      <p class="pd-body" style="margin-top: 20px">Ten years of this: every login screen, empty state, paywall, illustration, A/B test, and brand refresh. If you’re curious about any of it, I’d love to talk.</p>
      <div class="pd-btns" style="margin-top: 28px">
        <a href="mailto:hparamore@gmail.com" class="pd-btn pd-btn--primary">Email me →</a>
        <a href="/work" class="pd-btn">More work</a>
      </div>
    </div>
  </section>

  <!-- BLOCK: Next project -->
  <section class="pd-poster" data-screen-label="Next project">
    <div class="pd-poster__inner" style="padding-block: clamp(40px, 6vw, 72px)">
      <a href="/projects/mutual-design-system-case-study" class="pd-next">
        <div><div class="pd-kicker" style="margin-bottom: 16px">Next project</div><div class="pd-poster__title" style="font-size: clamp(44px, 6vw, 88px)">Mutual Design System</div></div>
        <span class="pd-next__box" aria-hidden="true"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
      </a>
    </div>
  </section>
<script>
  // Curated nine by default; the full archive is one click away.
  const grid = document.querySelector('[data-gallery]');
  const btn = document.querySelector('[data-toggle]');
  const count = document.querySelector('[data-count]');
  const total = grid.children.length, nine = grid.querySelectorAll('.is-featured').length;
  btn?.addEventListener('click', () => {
    const all = grid.classList.toggle('is-all');
    btn.setAttribute('aria-expanded', String(all));
    btn.textContent = all ? 'Show the curated ' + nine : 'Show all ' + total + ' screens';
    count.textContent = all ? total + ' screens, newest last' : nine + ' of ' + total + ' screens';
  });
</script>
</BaseV2>

<style is:global>
.mutual-gallery:not(.is-all) > figure:not(.is-featured){display:none}
</style>
