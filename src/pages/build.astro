---
import Base from '../layouts/Base.astro';
---

<Base
  title={"For Business, AI Tools, Custom-Built · Paramore.Design"}
  description={"One designer-developer building custom AI-powered tools that replace the stack of half-used SaaS small businesses get nickel-and-dimed by."}
>
<!-- Hero -->
  <section class="hero section pitch-hero">
    <div class="container">
      <div class="hero__content">
        <span class="hero__eyebrow">Now booking small business AI projects</span>
        <h1 class="display-xl hero__title">
          AI Tools, Built<br>
          For The Way Your<br>
          <span class="accent-text">Business Actually Runs.</span>
        </h1>
        <p class="hero__subtitle">
          You're paying ten different tools to do one job each. I'm one designer-developer
          who builds custom software, powered by AI, that replaces the stack and fits
          how <em>you</em> actually work.
        </p>
        <p class="hero__subtitle hero__subtitle--closer">
          No bloat. No retainers for features you'll never use. Just the tool you wish existed.
        </p>
        <div class="hero__cta">
          <a href="#contact" class="btn btn--primary">
            Book a 20-min Call <span class="btn__arrow">&rarr;</span>
          </a>
          <a href="#services" class="btn btn--secondary">See How It Works</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Problem Strip -->
  <section class="section problem" aria-labelledby="problem-heading">
    <div class="container">
      <span class="label">The Problem</span>
      <h2 id="problem-heading" class="section-intro" style="margin-top: var(--space-sm);">
        You didn't start a business to manage software.
      </h2>
      <div class="problem__grid">
        <div class="problem__item">
          <h3>Death by Subscriptions</h3>
          <p>Scheduling here. Invoicing there. CRM somewhere else. Each tool used for one feature, and the bills add up to thousands a year.</p>
        </div>
        <div class="problem__item">
          <h3>Spreadsheet Sprawl</h3>
          <p>Critical info lives in twelve different sheets, three inboxes, and one person's head. Nothing talks to anything.</p>
        </div>
        <div class="problem__item">
          <h3>Built For Someone Else</h3>
          <p>Big platforms are built for the average customer. You're not the average. The workflow you actually need doesn't exist yet.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Recent Work -->
  <section class="section" aria-labelledby="recent-heading">
    <div class="container">
      <div class="section-header" style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-md);">
        <div>
          <span class="label">Recent Builds</span>
          <h2 id="recent-heading" style="margin-top: var(--space-sm);">Real Tools, Real Businesses.</h2>
        </div>
        <a href="/work" class="btn btn--ghost">All Projects <span class="btn__arrow">&rarr;</span></a>
      </div>

      <div class="project-grid section-content">

        <a href="/projects/mutual" class="project-card project-card--featured">
          <div class="project-card__image" style="aspect-ratio: 2564 / 1275;">
            <img src="/assets/projects/mutual/MutualHero-wide.jpg" alt="Mutual, case study hero">
          </div>
          <div class="project-card__info">
            <span class="label project-card__label">Founder // 10 Years // Solo Designer</span>
            <h3 class="project-card__title">Mutual</h3>
            <p class="project-card__description">Co-founder and sole founding designer of the #1 LDS dating app. Ten years owning every surface: UI, brand, design system, research. Responsible for 40,000+ marriages and counting.</p>
          </div>
        </a>

        <a href="/projects/the-tree-service" class="project-card">
          <div class="project-card__image" style="aspect-ratio: 626 / 551;">
            <img src="/assets/images/projects/TreeServiceIpad.png" alt="The Tree Service, iPad view">
          </div>
          <div class="project-card__info">
            <span class="label project-card__label">Client Project // Field Ops &amp; AI</span>
            <h3 class="project-card__title">The Tree Service</h3>
            <p class="project-card__description">Field-ops tool that replaced four SaaS subscriptions with one: equipment, fuel, AI-parsed receipts, and crew safety checklists. Built solo in three weeks.</p>
          </div>
        </a>

        <a href="/projects/mutual-design-system.html" class="project-card">
          <div class="project-card__image" style="aspect-ratio: 1 / 1;">
            <img src="/assets/images/projects/MutualDesignSystemHero.jpg" alt="Mutual Design System, live token explorer"
                 onerror="this.style.display='none'; this.parentElement.style.background='var(--color-surface-elevated)';">
          </div>
          <div class="project-card__info">
            <span class="label project-card__label">Design System // Engineers &amp; AI Agents</span>
            <h3 class="project-card__title">Mutual Design System</h3>
            <p class="project-card__description">An interactive design system: 3 brands, 6 themes, semantic tokens, and live WCAG contrast. Structured so engineers and AI agents alike can build correct, on-brand, accessible UI from one source.</p>
          </div>
        </a>

        <a href="https://checkinapp.app" target="_blank" rel="noopener" class="project-card">
          <div class="project-card__image" style="aspect-ratio: 939 / 827;">
            <img src="/assets/projects/checkin/CheckinHero.jpg" alt="Checkin app, campfire check-in flow">
          </div>
          <div class="project-card__info">
            <span class="label project-card__label">Personal Project // iOS &amp; Android</span>
            <h3 class="project-card__title">Checkin</h3>
            <p class="project-card__description">Social coordination app where friends signal availability through campfire check-ins. Design, development, and product strategy, start to ship.</p>
          </div>
        </a>

      </div>
    </div>
  </section>

  <!-- Solution -->
  <section class="section" id="services" aria-labelledby="solution-heading">
    <div class="container">
      <span class="label">What I Do</span>
      <h2 id="solution-heading" style="margin-top: var(--space-sm);">One Person. Custom Built. AI Inside.</h2>
      <p class="solution__lead">
        I sit down with you, learn your business in plain language, then build software shaped
        around it. AI does the heavy lifting under the hood, drafting messages, parsing receipts,
        tracking inventory, summarizing leads, so the tool feels less like work and more like a
        smart assistant that already knows the job.
      </p>

      <div class="solution__grid">
        <div class="solution__card">
          <h3>Replace The Stack</h3>
          <p>One tool, your logo, your workflow. Built to do what your six current subscriptions do, minus the parts you never used.</p>
        </div>
        <div class="solution__card">
          <h3>AI That Earns Its Keep</h3>
          <p>Auto-categorize expenses. Draft client follow-ups. Turn a photo of a receipt into a logged transaction. Real time saved, every day.</p>
        </div>
        <div class="solution__card">
          <h3>Designed, Not Just Built</h3>
          <p>12+ years of product design means tools your team will actually use, not abandoned three weeks in because the UI fights them.</p>
        </div>
        <div class="solution__card">
          <h3>You Own It</h3>
          <p>No per-seat fees forever. No vendor lock-in. Build, ship, and let it run, I'm here when you want to grow it.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Industries -->
  <section class="section" aria-labelledby="industries-heading">
    <div class="container">
      <span class="label">Built For</span>
      <h2 id="industries-heading" style="margin-top: var(--space-sm);">Small businesses with real workflows.</h2>

      <div class="industries__grid">
        <div class="industry-card">
          <span class="industry-card__icon" aria-hidden="true">🌳</span>
          <h3>Trades &amp; Services</h3>
          <p>Tree work, plumbing, HVAC, electricians. Crews, equipment, fuel, receipts, jobs, one place.</p>
        </div>
        <div class="industry-card">
          <span class="industry-card__icon" aria-hidden="true">🌿</span>
          <h3>Yard &amp; Property</h3>
          <p>Lawn care, landscaping, pool service. Routes, clients, equipment, recurring billing.</p>
        </div>
        <div class="industry-card">
          <span class="industry-card__icon" aria-hidden="true">🏠</span>
          <h3>Real Estate Agents</h3>
          <p>Lead intake, follow-up drafts, property notes, custom client-facing pages.</p>
        </div>
        <div class="industry-card">
          <span class="industry-card__icon" aria-hidden="true">💍</span>
          <h3>Events &amp; Magazines</h3>
          <p>Submissions, status, payments, scheduling, designer handoff. The thing your spreadsheet wishes it was.</p>
        </div>
        <div class="industry-card">
          <span class="industry-card__icon" aria-hidden="true">🍽️</span>
          <h3>Restaurants &amp; Shops</h3>
          <p>Shift approvals, task lists, daily ops, employee comms, without buying a fortune-500 platform.</p>
        </div>
        <div class="industry-card">
          <span class="industry-card__icon" aria-hidden="true">💡</span>
          <h3>Founders With An Idea</h3>
          <p>You've had the napkin sketch in your head for two years. Let's make it real.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section" aria-labelledby="process-heading">
    <div class="container">
      <span class="label">How It Works</span>
      <h2 id="process-heading" style="margin-top: var(--space-sm);">Four steps, no surprises.</h2>

      <div class="process__grid">
        <div class="process__step">
          <h3>Talk</h3>
          <p>20 minutes, free. You walk me through what's eating your time. I tell you, plainly, whether I can help.</p>
        </div>
        <div class="process__step">
          <h3>Map</h3>
          <p>I sketch the tool, the AI pieces, what it replaces, and what it costs. Fixed price, not hourly.</p>
        </div>
        <div class="process__step">
          <h3>Build</h3>
          <p>I design and build it. You see progress weekly. We adjust as you actually use it.</p>
        </div>
        <div class="process__step">
          <h3>Ship</h3>
          <p>It's yours. I stick around for tweaks and improvements when you want them, never on a meter.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Trust -->
  <section class="section trust" aria-labelledby="trust-heading">
    <div class="container" style="text-align: center;">
      <span class="label">Past Clients &amp; Teams</span>
      <h2 id="trust-heading" style="margin-top: var(--space-sm); font-size: var(--text-2xl);">12+ Years Across Brands You Know.</h2>
      <div class="trust__logos">
        <span class="trust__logo">Mutual Dating</span>
        <span class="trust__logo">Ark Dating</span>
        <span class="trust__logo">Nu Skin</span>
        <span class="trust__logo">Angel Studios</span>
        <span class="trust__logo">Tech 9</span>
        <span class="trust__logo">Stotion</span>
        <span class="trust__logo">Paramore Real Estate</span>
      </div>
    </div>
  </section>

  <!-- Big CTA -->
  <section class="big-cta" id="contact">
    <div class="container container--narrow">
      <span class="label">Let's Talk</span>
      <h2 class="display-lg" style="margin-top: var(--space-md);">
        Tell me what's <span class="accent-text">eating your week.</span>
      </h2>
      <p>
        Free 20-minute call. Bring the spreadsheet, the tool you hate, the workflow that's
        held together with tape. I'll tell you straight whether AI can fix it, and what it'd
        cost to find out.
      </p>
      <div class="hero__cta" style="justify-content: center;">
        <a href="mailto:hunter@paramore.design" class="btn btn--primary">
          Book a Call <span class="btn__arrow">&rarr;</span>
        </a>
        <a href="/work" class="btn btn--secondary">See More Work</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
</Base>

<style is:global>
    /* ---------- Pitch / Hero refinements ---------- */
    .pitch-hero { padding-bottom: calc(var(--space-2xl) + 40px); }
    .pitch-hero .hero__content { max-width: 1200px; }
    .pitch-hero .hero__title { max-width: none; white-space: nowrap; }
    .pitch-hero .hero__subtitle { max-width: 56ch; }
    @media (max-width: 1100px) {
      .pitch-hero .hero__title { white-space: normal; }
    }
    .pitch-hero .hero__eyebrow {
      display: inline-flex;
      align-items: center;
      gap: var(--space-sm);
      padding: 6px 12px;
      border: 1px solid var(--color-border);
      border-radius: 999px;
      background: var(--color-accent-subtle);
      color: var(--color-text-secondary);
      font-family: var(--font-body);
      font-size: var(--text-xs);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: var(--tracking-wider);
      margin-bottom: var(--space-lg);
    }
    .pitch-hero .hero__eyebrow::before {
      content: "";
      width: 6px; height: 6px;
      background: var(--color-accent);
      border-radius: 50%;
      box-shadow: 0 0 12px var(--color-accent-glow);
    }

    /* ---------- Problem strip ---------- */
    .problem {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border-subtle);
      border-bottom: 1px solid var(--color-border-subtle);
    }
    .problem__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-2xl);
      margin-top: var(--space-2xl);
    }
    .problem__item h3 {
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      text-transform: uppercase;
      color: var(--color-text-primary);
      margin-bottom: var(--space-sm);
    }
    .problem__item p { font-size: var(--text-base); }
    @media (max-width: 768px) {
      .problem__grid { grid-template-columns: 1fr; gap: var(--space-xl); }
    }

    /* ---------- Solution / What I do ---------- */
    .solution__lead {
      max-width: 60ch;
      font-size: var(--text-lg);
      color: var(--color-text-primary);
      margin-bottom: var(--space-2xl);
    }
    .solution__grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: var(--space-lg);
    }
    .solution__card {
      padding: var(--space-xl);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-lg);
    }
    .solution__card h3 {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      text-transform: uppercase;
      color: var(--color-accent);
      margin-bottom: var(--space-sm);
      letter-spacing: var(--tracking-wide);
    }
    @media (max-width: 768px) {
      .solution__grid { grid-template-columns: 1fr; }
    }

    /* ---------- Industries ---------- */
    .industries__grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-md);
      margin-top: var(--space-2xl);
    }
    .industry-card {
      padding: var(--space-lg);
      background: var(--color-surface);
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      transition: border-color var(--duration-normal) var(--ease-out),
                  transform var(--duration-normal) var(--ease-out),
                  background var(--duration-normal) var(--ease-out);
    }
    .industry-card:hover {
      border-color: var(--color-accent);
      background: var(--color-surface-elevated);
      transform: translateY(-2px);
    }
    .industry-card__icon {
      font-size: var(--text-2xl);
      margin-bottom: var(--space-sm);
      display: block;
    }
    .industry-card h3 {
      font-family: var(--font-display);
      font-size: var(--text-lg);
      text-transform: uppercase;
      letter-spacing: var(--tracking-wide);
      margin-bottom: var(--space-xs);
    }
    .industry-card p {
      font-size: var(--text-sm);
      color: var(--color-text-secondary);
      line-height: var(--leading-snug);
    }
    @media (max-width: 900px) { .industries__grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 540px) { .industries__grid { grid-template-columns: 1fr; } }

    /* ---------- Process ---------- */
    .process__grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-lg);
      margin-top: var(--space-2xl);
      counter-reset: step;
    }
    .process__step {
      counter-increment: step;
      position: relative;
      padding-top: var(--space-2xl);
    }
    .process__step::before {
      content: "0" counter(step);
      position: absolute;
      top: 0;
      left: 0;
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      color: var(--color-accent);
      letter-spacing: var(--tracking-wide);
    }
    .process__step h3 {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      text-transform: uppercase;
      margin-bottom: var(--space-sm);
    }
    .process__step p { font-size: var(--text-base); }
    @media (max-width: 900px) { .process__grid { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 540px) { .process__grid { grid-template-columns: 1fr; } }

    /* ---------- Trust strip ---------- */
    .trust {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border-subtle);
      border-bottom: 1px solid var(--color-border-subtle);
    }
    .trust__logos {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2xl);
      align-items: center;
      justify-content: center;
      margin-top: var(--space-xl);
    }
    .trust__logo {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
      color: var(--color-text-tertiary);
      transition: color var(--duration-normal) var(--ease-out);
    }
    .trust__logo:hover { color: var(--color-text-primary); }

    /* ---------- Big CTA ---------- */
    .big-cta {
      text-align: center;
      padding: var(--space-5xl) var(--content-padding);
    }
    .big-cta h2 {
      font-size: var(--text-5xl);
      max-width: 18ch;
      margin: 0 auto var(--space-lg);
    }
    .big-cta p {
      max-width: 50ch;
      margin: 0 auto var(--space-2xl);
      font-size: var(--text-lg);
      color: var(--color-text-secondary);
    }
    @media (max-width: 768px) { .big-cta h2 { font-size: var(--text-4xl); } }

    /* ---------- Section spacing nudge for stacked content sections ---------- */
    .section-intro { max-width: 60ch; margin-bottom: var(--space-md); }

    /* Plain grey placeholder for project cards awaiting real imagery */
    .project-card__image--blank {
      background: var(--color-surface-elevated);
      border: 1px solid var(--color-border-subtle);
    }
  </style>
