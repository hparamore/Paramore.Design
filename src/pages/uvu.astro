---
import Base from '../layouts/Base.astro';
import '../styles/workshops/uvu.css';

/**
 * Handout page for the UVU design business workshop (October 2026). The deck's closing slide
 * has a QR code pointing here, so the URL stays short: paramore.design/uvu.
 * Unlisted (not in nav or the work grid) and noindex, same as the client pitch pages.
 *
 * The two PDFs are generated from scripts/handouts/*.html by scripts/handouts/build.sh.
 * Edit the HTML and rebuild; don't edit the PDFs.
 */

const downloads = [
  {
    name: 'Pricing worksheet',
    desc: 'Six questions to answer before you quote any project, with room to write.',
    href: '/assets/handouts/uvu/pricing-worksheet.pdf',
    file: 'pricing-worksheet.pdf',
  },
  {
    name: 'Contract checklist',
    desc: 'The five clauses every freelance contract needs, plus what to do when a client pushes back on price.',
    href: '/assets/handouts/uvu/contract-checklist.pdf',
    file: 'contract-checklist.pdf',
  },
  {
    name: 'Business setup checklist',
    desc: 'LLC, EIN, bank account, receipts, and what to set aside for taxes, from my tax preparer.',
    href: '/assets/handouts/uvu/business-setup.pdf',
    file: 'business-setup.pdf',
  },
];

// Mirrors the worksheet PDF. Change both together.
const pricingQuestions = [
  { q: 'Scope', a: 'What exactly is included, and what isn’t?' },
  { q: 'Their alternative', a: 'What would they do if you didn’t exist? Wix, the nephew, doing nothing?' },
  { q: 'The value to them', a: 'What is the problem costing them now, in their words?' },
  { q: 'Your floor', a: '(What you need to keep + business costs) ÷ 0.7 for taxes ÷ about 1,000 billable hours. Never quote below it.' },
  { q: 'The bundle', a: 'A starting price, a monthly line, and one or two add-ons tied to outcomes they care about.' },
  { q: 'Time check', a: 'Estimated hours × your floor × 1.25–1.5 for revisions and surprises. A sanity check, not the price you quote.' },
];

// Mirrors the contract checklist PDF. Change both together.
const clauses = [
  { name: 'Scope', desc: 'Exactly what’s included, and what isn’t.' },
  { name: 'Revisions', desc: 'How many rounds, and what extra rounds cost.' },
  { name: 'Payment', desc: '50% up front, the rest on delivery, with due dates.' },
  { name: 'Ownership', desc: 'Rights transfer when the final invoice is paid.' },
  { name: 'Kill fee', desc: 'What you’re owed if they cancel partway through. (In my opinion, not always necessary.)' },
];

// Mirrors scripts/handouts/business-setup.html. From Hunter's tax preparer, Oct 21, 2026. Change both together.
const setup = [
  { name: 'File direct', desc: 'Form your LLC with the Utah Division of Corporations ($59 to file, $18 a year to renew), and get your EIN free at IRS.gov. Lookalike sites and official-looking emails charge $200–500 for the same forms.' },
  { name: 'Business account first', desc: 'Every client payment lands there, then you pay yourself. Never pay personal bills from it.' },
  { name: 'Keep every receipt', desc: 'A phone photo in a folder counts. Card statements are a weak backup in an audit.' },
  { name: 'Track your miles', desc: 'Every business drive is a deduction: $0.72 a mile right now.' },
  { name: 'Set money aside', desc: '25–30% of every payment if it’s just you. Closer to 20% with a spouse, kids, and real expenses.' },
];

const taxQuestions = [
  { q: 'Should my spouse be on the LLC?', a: 'A single-member LLC pays self-employment tax on all of its profit. A spouse as a non-working partner can cut that in half.' },
  { q: 'When does an S corp make sense?', a: 'Often around $40K a year in freelance net income.' },
  { q: 'Do I owe quarterly taxes?', a: 'Once you’re past your first year. A tax pro can work out the number from last year’s bill.' },
  { q: 'What can I deduct?', a: 'One of the most important things you can do is lower the amount you’re taxed on. An LLC can deduct a lot.' },
];

// Hunter's tax preparer, who OK'd being listed for students (Oct 21, 2026). Matches the deck.
const taxPro = { name: 'Suzette Carter', firm: 'Oak Haven CPAs', city: 'Pleasant Grove, Utah', phone: '801.369.4752', tel: '+18013694752', email: 'Suzette@oakhavencpas.com' };

const upsell = [
  { name: 'Sell outcomes', desc: '“More Google reviews,” not “an SMS integration.”' },
  { name: 'Offer options up front', desc: 'A starting bundle plus add-ons. They choose; you don’t push.' },
  { name: 'Ask after a win', desc: 'Offer more right after the first thing works, not before.' },
  { name: 'Stay in the relationship', desc: 'A monthly line keeps you around. That’s where the next project comes from.' },
];

const actions = [
  { name: 'Write your one-sentence brand', desc: 'I help [who] get [result] by [what you do]. Before you post anything else.' },
  { name: 'Study one local business', desc: 'List five things their website gets wrong, in their words, not design words.' },
  { name: 'Set up one account', desc: 'Contra, Gumroad, or Figma Community. Just one.' },
  { name: 'Have one lunch', desc: 'With someone already doing the work you want to do.' },
];

const books = [
  { title: 'Obviously Awesome', author: 'April Dunford', why: 'Positioning: what you are, compared to what, and for whom.' },
  { title: 'Simple Marketing for Smart People', author: 'Billy Broas', why: 'Messaging: what to say to people at each stage.' },
  { title: 'SPIN Selling', author: 'Neil Rackham', why: 'Ask questions that let the client name the problem and what it costs them.' },
  { title: 'The Win Without Pitching Manifesto', author: 'Blair Enns', why: 'The next level: specialize, and stop giving your thinking away.' },
];

const linkGroups = [
  {
    title: 'Find work',
    links: [
      { name: 'Contra', href: 'https://contra.com', note: 'Freelance profiles and projects' },
      { name: 'Upwork', href: 'https://www.upwork.com', note: 'Freelance marketplace' },
      { name: 'Dribbble', href: 'https://dribbble.com', note: 'Portfolio and job board' },
      { name: 'A.Team', href: 'https://www.a.team', note: 'Vetted freelance product teams' },
      { name: 'GoFractional', href: 'https://www.gofractional.com', note: 'Part-time and fractional roles' },
    ],
  },
  {
    title: 'Sell what you make',
    links: [
      { name: 'Figma Community', href: 'https://www.figma.com/community', note: 'Paid and free design resources' },
      { name: 'Framer Marketplace', href: 'https://www.framer.com/marketplace/', note: 'Website templates' },
      { name: 'Gumroad', href: 'https://gumroad.com', note: 'Sell any digital product' },
      { name: 'Etsy', href: 'https://www.etsy.com', note: 'Printables, templates, physical goods' },
      { name: 'Shopify', href: 'https://www.shopify.com', note: 'Your own store, when you have a product' },
    ],
  },
  {
    title: 'Utah & business setup',
    links: [
      { name: 'Utah SBDC', href: 'https://utahsbdc.org', note: 'Free small business advising' },
      { name: 'Utah Division of Corporations', href: 'https://corporations.utah.gov', note: 'Register or renew an LLC (go here directly)' },
      { name: 'IRS: get an EIN', href: 'https://www.irs.gov/businesses/small-businesses-self-employed/get-an-employer-identification-number', note: 'Free. Only use IRS.gov' },
      { name: 'Silicon Slopes', href: 'https://www.siliconslopes.com', note: 'Utah tech community and events' },
      { name: 'AIGA', href: 'https://www.aiga.org', note: 'Professional design association, with a Salt Lake chapter' },
    ],
  },
];
---

<Base
  title="Making Your First $1,000 as a New Designer · UVU Resources · Paramore.Design"
  description="Worksheets, checklists, books and links from Hunter Paramore’s design business workshop at UVU."
>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div class="uvu-page">

  <!-- Hero: the two downloads are the reason people scanned the QR code, so they sit up top -->
  <section class="project-hero uvu-hero">
    <div class="container">
      <span class="label project-hero__label" style="display: block;">UVU // Design Business Workshop</span>
      <h1 class="display-lg project-hero__title">Making your first <span class="accent-text">$1,000</span> as a new designer</h1>
      <p class="uvu-lede">
        Everything from the workshop in one place: the pricing worksheet, the contract checklist,
        the business setup checklist, the books, and the links. Print the worksheets, or fill them in on your tablet.
      </p>
      <div class="uvu-downloads">
        {downloads.map((d) => (
          <a class="uvu-download" href={d.href} download={d.file}>
            <span class="uvu-download__tag">PDF</span>
            <span class="uvu-download__name">{d.name}</span>
            <span class="uvu-download__desc">{d.desc}</span>
            <span class="uvu-download__cta">Download <span aria-hidden="true">&darr;</span></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- The big idea, as a reminder of the thread through the talk -->
  <section class="section uvu-idea" aria-label="The big idea">
    <div class="container">
      <p class="uvu-idea__quote">Marketing is teaching people how to value your work.</p>
      <p class="uvu-idea__sub">It’s making an argument for something. Not arguing. Making the case.</p>
    </div>
  </section>

  <!-- Pricing worksheet, readable on the page too -->
  <section class="section" aria-labelledby="uvu-pricing-heading">
    <div class="container">
      <span class="section-label">Pricing worksheet</span>
      <h2 id="uvu-pricing-heading" class="section-title">Before you quote anything</h2>
      <p class="section-sub">Price the project, not the hour. Answer these six first.</p>
      <ol class="uvu-rows">
        {pricingQuestions.map((item, i) => (
          <li class="uvu-row">
            <span class="uvu-row__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="uvu-row__name">{item.q}</span>
            <span class="uvu-row__desc">{item.a}</span>
          </li>
        ))}
      </ol>
      <div class="uvu-floor">
        <p class="uvu-floor__label">Find your floor</p>
        <p class="uvu-floor__math">(What you need to keep + costs) ÷ 0.7 ÷ ~1,000 billable hours</p>
        <p class="uvu-floor__eg">Half a freelance week goes to finding clients, email, and admin, so plan on about 1,000 billable hours a year, not 2,080. Need $50K to live on? Bill about $75K, which is about $75 an hour. That’s the floor, not the price.</p>
      </div>
    </div>
  </section>

  <!-- Contract checklist -->
  <section class="section" aria-labelledby="uvu-contract-heading">
    <div class="container">
      <span class="section-label">Contract checklist</span>
      <h2 id="uvu-contract-heading" class="section-title">Five clauses that protect you</h2>
      <ul class="uvu-rows">
        {clauses.map((c) => (
          <li class="uvu-row uvu-row--check">
            <span class="uvu-row__check" aria-hidden="true"></span>
            <span class="uvu-row__name">{c.name}</span>
            <span class="uvu-row__desc">{c.desc}</span>
          </li>
        ))}
      </ul>
      <p class="uvu-note">Not legal advice. For anything big, have a lawyer look at your template once.</p>
    </div>
  </section>

  <!-- Business setup, from Hunter's tax preparer -->
  <section class="section" aria-labelledby="uvu-setup-heading">
    <div class="container">
      <span class="section-label">From my tax preparer</span>
      <h2 id="uvu-setup-heading" class="section-title">Set it up right from day one</h2>
      <ul class="uvu-rows">
        {setup.map((c) => (
          <li class="uvu-row uvu-row--check">
            <span class="uvu-row__check" aria-hidden="true"></span>
            <span class="uvu-row__name">{c.name}</span>
            <span class="uvu-row__desc">{c.desc}</span>
          </li>
        ))}
      </ul>
      <div class="uvu-card uvu-questions">
        <h3 class="uvu-card__title">Questions to ask a tax pro</h3>
        <ul>
          {taxQuestions.map((t) => <li><strong>{t.q}</strong> {t.a}</li>)}
        </ul>
      </div>
      <div class="uvu-taxpro">
        <span class="uvu-taxpro__label">Who I use</span>
        <span class="uvu-taxpro__name">{taxPro.name}</span>
        <span class="uvu-taxpro__meta">{taxPro.firm} · {taxPro.city} · <a href={`tel:${taxPro.tel}`}>{taxPro.phone}</a> · <a href={`mailto:${taxPro.email}`}>{taxPro.email}</a></span>
      </div>
      <p class="uvu-note">Not tax or legal advice. Talk to a tax professional before you choose an entity.</p>
    </div>
  </section>

  <!-- The objection script from the talk -->
  <section class="section uvu-band" aria-labelledby="uvu-objection-heading">
    <div class="container">
      <span class="section-label">When they say “I can get it cheaper”</span>
      <h2 id="uvu-objection-heading" class="section-title">Agree, then ask</h2>
      <blockquote class="uvu-script">
        <p>“He probably can, and that might be the right call.</p>
        <p class="uvu-script__ask">What made you reach out to me?”</p>
      </blockquote>
      <p class="section-sub">Don’t defend your value and don’t drop your price. Listen to the answer: it’s your value, in their words. If the budget really is lower, cut the scope, not the price.</p>
    </div>
  </section>

  <!-- Upsell -->
  <section class="section" aria-labelledby="uvu-upsell-heading">
    <div class="container">
      <span class="section-label">After the yes</span>
      <h2 id="uvu-upsell-heading" class="section-title">Upsell without the sleaze</h2>
      <ul class="uvu-rows">
        {upsell.map((u, i) => (
          <li class="uvu-row">
            <span class="uvu-row__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <span class="uvu-row__name">{u.name}</span>
            <span class="uvu-row__desc">{u.desc}</span>
          </li>
        ))}
      </ul>
      <p class="uvu-note">The sleaze test: if you’d be embarrassed to explain why they need it, don’t sell it.</p>
    </div>
  </section>

  <!-- One thing this week -->
  <section class="section" aria-labelledby="uvu-action-heading">
    <div class="container">
      <span class="section-label">The promise, kept</span>
      <h2 id="uvu-action-heading" class="section-title">Pick your one thing this week</h2>
      <div class="uvu-grid uvu-grid--4">
        {actions.map((a) => (
          <div class="uvu-card">
            <h3 class="uvu-card__title">{a.name}</h3>
            <p class="uvu-card__body">{a.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Reading list -->
  <section class="section" aria-labelledby="uvu-books-heading">
    <div class="container">
      <span class="section-label">Keep learning</span>
      <h2 id="uvu-books-heading" class="section-title">Four books, in this order</h2>
      <ol class="uvu-books">
        {books.map((b, i) => (
          <li class="uvu-book">
            <span class="uvu-row__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="uvu-book__title">{b.title}</h3>
              <p class="uvu-book__author">{b.author}</p>
              <p class="uvu-book__why">{b.why}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Links -->
  <section class="section" aria-labelledby="uvu-links-heading">
    <div class="container">
      <span class="section-label">Where to start</span>
      <h2 id="uvu-links-heading" class="section-title">Links from the talk</h2>
      <div class="uvu-grid uvu-grid--3">
        {linkGroups.map((g) => (
          <div class="uvu-links">
            <h3 class="uvu-links__title">{g.title}</h3>
            <ul>
              {g.links.map((l) => (
                <li>
                  <a href={l.href} target="_blank" rel="noopener">{l.name} <span aria-hidden="true">&nearr;</span></a>
                  <span class="uvu-links__note">{l.note}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section class="section uvu-band" style="text-align: center;" aria-labelledby="uvu-contact-heading">
    <div class="container">
      <span class="section-label">Questions after the talk?</span>
      <h2 id="uvu-contact-heading" class="section-title">Say hi</h2>
      <p class="section-sub">I’m happy to look at a portfolio or a first proposal.</p>
      <div class="hero__cta uvu-contact">
        <a href="mailto:hparamore@gmail.com" class="btn btn--primary">Email Hunter <span class="btn__arrow">&rarr;</span></a>
        <a href="/work" class="btn btn--secondary">See my work</a>
      </div>
    </div>
  </section>

  </div>
</Base>
