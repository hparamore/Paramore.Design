---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import HeroFlow from '../components/HeroFlow.astro';
import Base from '../layouts/Base.astro';

// Usual order, except the small-business client work sits as its own row right after
// Mutual Design System (Hunter, 2026-11-24: lower down than leading the grid, as it did
// from 2026-10-22).
const clientWork = ['paramore-real-estate', 'the-tree-service'];
const sorted = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
const rest = sorted.filter((p) => !clientWork.includes(p.id));
const anchor = rest.findIndex((p) => p.id === 'mutual-design-system') + 1;
const projects = [
  ...rest.slice(0, anchor),
  ...clientWork.map((id) => sorted.find((p) => p.id === id)).filter((p) => p !== undefined),
  ...rest.slice(anchor),
];
---

<Base
  title={"Hunter Paramore · AI & Tech Help for Utah Small Businesses · Paramore.Design"}
  description={"Hunter Paramore is the AI and tech guy for Utah small businesses: websites, custom apps, and AI tools that save time and bring in customers. 13 years designing and building apps."}
>
<!-- Hunter (2026-11-24): the work leads and should show above the fold, so the page opens on the
     numbers and the availability line, and the headline moves below the work. The h1 stays first
     for screen readers and search. -->
  <h1 class="visually-hidden">Hunter Paramore, AI and tech help for Utah small businesses</h1>

  <!-- Proof strip: the numbers, scannable, before anything else -->
  <section class="home-proof">
    <div class="container">
      <!-- A short intro before the numbers (Hunter, 2026-11-24), kept small so the work still shows above the fold -->
      <p class="home-intro">
        I&rsquo;m Hunter. I design and build apps, games and tools, and I help Utah small businesses
        with websites, custom software and AI that takes the busywork off their plate.
      </p>
      <div class="home-stats">
        <div class="home-stat">
          <div class="home-stat__value">13 yrs</div>
          <div class="home-stat__label">Designing and shipping products.</div>
        </div>
        <div class="home-stat">
          <div class="home-stat__value">40k+</div>
          <div class="home-stat__label">Marriages from Mutual, the app I co-founded.</div>
        </div>
        <div class="home-stat">
          <div class="home-stat__value">#1</div>
          <div class="home-stat__label">LDS dating app worldwide. I was its only designer for ten years.</div>
        </div>
        <div class="home-stat">
          <div class="home-stat__value">9</div>
          <div class="home-stat__label">Apps of my own that I designed, built and launched myself.</div>
        </div>
      </div>
      <!-- Availability: a business owner&apos;s first question is &quot;are you taking clients?&quot; (job search lives on /resume) -->
      <p class="home-avail__text">
        <span class="home-avail__dot" aria-hidden="true"></span>
        <strong>Taking on new local clients.</strong> You work with me directly, from the first call on.
        <a href="mailto:hparamore@gmail.com">Get in touch &rarr;</a>
      </p>
    </div>
  </section>

  <!-- Selected Work -->
  <section class="section home-work" aria-labelledby="work-heading">
    <div class="container">
      <div class="section-header" style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-md);">
        <div>
          <span class="section-label">Selected Work</span>
          <h2 id="work-heading" class="section-title">Things I&rsquo;ve built.</h2>
        </div>
        <a href="/work" class="btn btn--ghost">All Projects <span class="btn__arrow">&rarr;</span></a>
      </div>

      <div class="project-grid section-content">

        {projects.filter((p) => p.data.onHome).map((p) => <ProjectCard project={p.data} />)}

      </div>
    </div>
  </section>

  <!-- How I can help: one compact band (Hunter, 2026-11-24: "way way smaller"). Same hairline
       frame as the proof strip, heading on the left, four short items on the right. -->
  <section class="home-help" id="how-i-work" aria-labelledby="help-heading">
    <div class="container">
      <div class="home-help__band">
        <div class="home-help__head">
          <span class="section-label">What I Do</span>
          <h2 id="help-heading" class="home-help__title">How I can help.</h2>
        </div>
        <ul class="home-help__list" role="list">
          <li class="home-help__item">
            <h3 class="home-help__name">AI that saves you time</h3>
            <p class="home-help__desc">Follow-ups, review replies, social posts and after-hours answers for customers, written for you.</p>
          </li>
          <li class="home-help__item">
            <h3 class="home-help__name">Custom apps &amp; tools</h3>
            <p class="home-help__desc">When off-the-shelf software doesn&rsquo;t fit, I build one that does. It often replaces a few subscriptions.</p>
          </li>
          <li class="home-help__item">
            <h3 class="home-help__name">Websites that bring people in</h3>
            <p class="home-help__desc">Hours, prices and booking one tap away on a phone, so the people who find you come in.</p>
          </li>
          <li class="home-help__item">
            <h3 class="home-help__name">Someone to call</h3>
            <p class="home-help__desc">Ongoing help when something breaks, or when you suspect there&rsquo;s a better way to do it.</p>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Hero, now below the work -->
  <section class="hero section home-hero" aria-labelledby="hero-heading">
    <div class="container home-hero__grid">
      <div class="hero__content">
        <h2 id="hero-heading" class="display-xl hero__title">
          Your business&rsquo;s<br><span class="accent-text">AI &amp; tech guy.</span>
        </h2>
        <p class="hero__subtitle">
          I&rsquo;m Hunter. I&rsquo;ve designed and built apps for 13 years, including Mutual,
          which has helped more than 40,000 couples get married. Now I help small businesses go
          from trying AI to actually using it for their busywork.
        </p>
        <div class="hero__cta">
          <a href="mailto:hparamore@gmail.com?subject=Here%27s%20what%27s%20slowing%20us%20down" class="btn btn--primary">
            Tell me what&rsquo;s slowing you down <span class="btn__arrow">&rarr;</span>
          </a>
        </div>
      </div>
      <!-- Show, don't tell: one real automation, drawn as it runs -->
      <HeroFlow />
    </div>
  </section>

  <!-- About teaser -->
  <section class="section" aria-labelledby="about-heading">
    <div class="container">
      <span class="section-label">About</span>
      <h2 id="about-heading" style="margin-bottom: var(--space-lg);" class="section-title">You&rsquo;ll work with me.</h2>
      <p class="home-about__text">
        I design and build everything myself, so the person you talk to is the person doing the
        work. I start by looking at your business the way a customer would, and I fix whatever
        gets in their way first. A local shop gets the same care I&rsquo;ve put into apps used by
        thousands of people.
      </p>
      <div style="margin-top: var(--space-xl);">
        <a href="/about" class="btn btn--ghost">More about me <span class="btn__arrow">&rarr;</span></a>
      </div>
    </div>
  </section>

  <!-- Worked-with strip -->
  <section class="section home-brands" aria-labelledby="brands-heading">
    <div class="container" style="text-align: center;">
      <span class="section-label">Worked With</span>
      <h2 id="brands-heading" class="section-title">Brands I&rsquo;ve worked with.</h2>
      <div class="home-brands__logos">
        <span class="home-brands__logo">Mutual</span>
        <span class="home-brands__logo">Ark Dating</span>
        <span class="home-brands__logo">Nu Skin</span>
        <span class="home-brands__logo">Angel Studios</span>
        <span class="home-brands__logo">Tech 9</span>
        <span class="home-brands__logo">Stotion</span>
        <span class="home-brands__logo">Paramore Real Estate</span>
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="home-closing" id="contact">
    <div class="container">
      <span class="section-label">Get In Touch</span>
      <h2 class="section-title">
        What&rsquo;s <span class="accent-text">slowing you down?</span>
      </h2>
      <p>
        Tell me about it and I&rsquo;ll tell you what I&rsquo;d try first. That part is free.
      </p>
      <div class="hero__cta" style="justify-content: center;">
        <a href="mailto:hparamore@gmail.com?subject=Here%27s%20what%27s%20slowing%20us%20down" class="btn btn--primary">
          Tell me about it <span class="btn__arrow">&rarr;</span>
        </a>
        <a href="/resume" class="btn btn--secondary">Résumé</a>
        <a href="/work" class="btn btn--secondary">See the work</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
</Base>

<style is:global>
    /* ---------- Hero: hard-left, wide headline, momentum into work ---------- */
    /* The global .hero is display:flex, which made its .container shrink-wrap and
       center (the "stacked + floating" feel). Fill the container so the hero
       left-aligns to the page like every other section. */
    .home-hero .container { width: 100%; }
    /* Below the work now, so normal section rhythm instead of clearing the nav. */
    .home-hero { padding-top: var(--space-3xl); padding-bottom: var(--space-2xl); }
    .home-hero .hero__content { max-width: 1080px; }
    .home-hero .hero__title {
      max-width: none;
      font-size: clamp(var(--text-4xl), 6.6vw, var(--text-6xl));
    }
    .home-hero .hero__subtitle { max-width: 64ch; text-wrap: pretty; }
    .home-hero .accent-text { color: var(--color-accent); }
    /* The work follows the proof strip closely, so its first row shows above the fold. */
    .home-work { padding-top: var(--space-xl); }

    /* ---------- How I can help: one compact band ----------
       Hairline top and bottom like the proof strip. A small display heading on the left,
       four short items on the right in body type, so it reads as a quiet index, not a
       second hero. */
    .home-help { padding: var(--space-xl) 0; }
    .home-help__band {
      display: grid;
      grid-template-columns: minmax(180px, 1fr) 3fr;
      gap: var(--space-2xl);
      padding: var(--space-xl) 0;
      border-top: 1px solid var(--color-border-subtle);
      border-bottom: 1px solid var(--color-border-subtle);
      align-items: start;
    }
    .home-help__head .section-label { margin-bottom: var(--space-sm); }
    .home-help__title {
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      text-transform: uppercase;
      letter-spacing: var(--tracking-display);
      line-height: 1;
      margin: 0;
    }
    .home-help__list {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: var(--space-xl);
      list-style: none;
      margin: 0;
      padding: 0;
    }
    .home-help__name {
      font-family: var(--font-body);
      font-size: var(--text-base);
      font-weight: 600;
      line-height: 1.3;
      color: var(--color-text-primary);
      margin: 0 0 var(--space-xs);
    }
    /* The brand's "//" separator, small, as the only ornament. */
    .home-help__name::before {
      content: "// ";
      color: var(--color-accent);
      font-weight: 500;
    }
    .home-help__desc {
      font-size: var(--text-sm);
      line-height: 1.5;
      color: var(--color-text-secondary);
      margin: 0;
    }
    @media (max-width: 1000px) {
      .home-help__band { grid-template-columns: 1fr; gap: var(--space-lg); }
      .home-help__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    }
    @media (max-width: 560px) {
      .home-help__list { grid-template-columns: minmax(0, 1fr); gap: var(--space-md); }
    }

    /* ---------- Proof strip ----------
       Sits directly under the hero so the numbers land before any scrolling.
       Four across on desktop, two on tablet, two on phones — never one column,
       because a single stack reads as a list instead of a scoreboard. */
    .home-proof {
      padding-top: calc(var(--space-4xl) + var(--space-lg));  /* clears the fixed nav (84px) with room */
      padding-bottom: 0;
    }
    .home-intro {
      font-size: clamp(var(--text-lg), 2vw, var(--text-xl));
      line-height: 1.45;
      color: var(--color-text-primary);
      max-width: 52ch;
      text-wrap: pretty;
      margin: 0 0 var(--space-xl);
    }
    .home-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-2xl);
      padding: var(--space-xl) 0;
      border-top: 1px solid var(--color-border-subtle);
      border-bottom: 1px solid var(--color-border-subtle);
    }
    .home-stat__value {
      font-family: var(--font-display);
      font-size: clamp(var(--text-4xl), 4.5vw, var(--text-5xl));
      line-height: 0.95;
      letter-spacing: var(--tracking-display);
      color: var(--color-accent);
      margin-bottom: var(--space-xs);
    }
    .home-stat__label {
      font-size: var(--text-sm);
      line-height: 1.4;
      color: var(--color-text-secondary);
      max-width: 24ch;
    }
    @media (max-width: 900px) {
      .home-stats { grid-template-columns: repeat(2, 1fr); gap: var(--space-xl); }
    }
    @media (max-width: 560px) {
      .home-stats { gap: var(--space-lg); }
      .home-stat__label { font-size: var(--text-xs); }
    }

    /* ---------- Availability ----------
       A single quiet line. It answers "are you even looking?" without turning the
       page into a job board. The dot is the only ornament it gets. */
    .home-avail__text {
      margin-top: var(--space-lg);
      font-size: var(--text-base);
      color: var(--color-text-secondary);
      line-height: 1.6;
      max-width: 78ch;
    }
    .home-avail__text strong { color: var(--color-text-primary); }
    .home-avail__text a { color: var(--color-accent); margin-left: 0.35em; white-space: nowrap; }
    .home-avail__dot {
      display: inline-block;
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--color-accent);
      margin-right: var(--space-sm);
      vertical-align: middle;
    }

    .home-toolkit__row h4 {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      letter-spacing: var(--tracking-display);
      text-transform: uppercase;
      color: var(--color-accent);
      margin: 0;
    }

    /* ---------- Worked-with strip ---------- */
    .home-brands {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border-subtle);
      border-bottom: 1px solid var(--color-border-subtle);
    }
    .home-brands__logos {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2xl);
      align-items: center;
      justify-content: center;
      margin-top: var(--space-xl);
    }
    .home-brands__logo {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
      color: var(--color-text-tertiary);
      transition: color var(--duration-normal) var(--ease-out);
    }
    .home-brands__logo:hover { color: var(--color-text-primary); }

    /* ---------- About teaser ---------- */
    .home-about__text {
      max-width: 62ch;
      font-size: var(--text-lg);
      line-height: 1.6;
      color: var(--color-text-secondary);
    }
    .home-about__text strong { color: var(--color-text-primary); font-weight: 600; }

    /* ---------- How I Lead callout: 3-col (heading 1 / body 2) ---------- */
    .home-callout {
      border: 1px solid var(--color-accent-muted);
      border-radius: var(--radius-xl);
      background:
        linear-gradient(180deg, var(--color-accent-subtle), transparent 70%),
        var(--color-surface);
      padding: var(--space-4xl) var(--space-3xl);
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: var(--space-3xl);
      align-items: start;
    }
    .home-callout__head .label {
      display: block;
      font-size: var(--text-base);
      margin-bottom: var(--space-xl);
    }
    .home-callout__quote {
      font-family: var(--font-display);
      font-size: clamp(var(--text-4xl), 3.6vw, var(--text-5xl));
      line-height: 0.98;
      letter-spacing: var(--tracking-display);
      text-transform: uppercase;
      text-wrap: balance;
      margin: 0;
    }
    .home-callout__quote .accent { color: var(--color-accent); }
    .home-callout__body p {
      font-size: var(--text-lg);
      line-height: 1.65;
      color: var(--color-text-secondary);
    }
    .home-callout__body p + p { margin-top: var(--space-lg); }
    @media (max-width: 768px) {
      .home-callout {
        grid-template-columns: 1fr;
        gap: var(--space-lg);
        padding: var(--space-2xl) var(--space-xl);
      }
    }

    /* ---------- Pull quote / testimonial ----------
       No side-stripe border (the AI tell). An oversized display quote mark in
       the accent carries the emphasis instead. */
    .home-pullquote {
      max-width: 760px;
      margin: var(--space-2xl) auto 0;
      position: relative;
      padding-top: var(--space-lg);
    }
    .home-pullquote::before {
      content: "\201C";
      display: block;
      font-family: var(--font-display);
      font-size: var(--text-6xl);
      line-height: 0.6;
      color: var(--color-accent);
      margin-bottom: var(--space-sm);
    }
    .home-pullquote blockquote {
      font-family: var(--font-body);
      font-size: var(--text-xl);
      font-weight: 500;
      line-height: 1.4;
      color: var(--color-text-primary);
    }
    .home-pullquote cite {
      display: block;
      margin-top: var(--space-md);
      font-style: normal;
      font-size: var(--text-sm);
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
      color: var(--color-text-tertiary);
    }

    /* ---------- Toolkit columns ---------- */
    .home-toolkit { margin-top: var(--space-2xl); }
    /* Label left, the list as one flowing line right — a third of the height of the
       old three-column bullet lists, and still every keyword a filter might want. */
    .home-toolkit__row {
      display: grid;
      grid-template-columns: 140px minmax(0, 1fr);
      gap: var(--space-xl);
      padding: var(--space-lg) 0;
      border-top: 1px solid var(--color-border-subtle);
      align-items: baseline;
    }
    .home-toolkit__row:last-child { border-bottom: 1px solid var(--color-border-subtle); }
    .home-toolkit__row p {
      font-size: var(--text-base);
      color: var(--color-text-secondary);
      line-height: 1.6;
    }
    @media (max-width: 700px) {
      .home-toolkit__row { grid-template-columns: 1fr; gap: var(--space-xs); }
    }
    
    
    
    


    /* ---------- Closing ---------- */
    .home-closing { text-align: center; padding: var(--space-3xl) var(--content-padding); }
    .home-closing h2 {
      font-size: var(--text-5xl);
      max-width: 18ch;
      margin: 0 auto var(--space-md);
    }
    .home-closing .accent-text { color: var(--color-accent); }
    .home-closing p {
      max-width: 50ch;
      margin: 0 auto var(--space-2xl);
      font-size: var(--text-lg);
      color: var(--color-text-secondary);
    }
    @media (max-width: 768px) { .home-closing h2 { font-size: var(--text-4xl); } }
  </style>
