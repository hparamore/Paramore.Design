---
// Ported from the Claude Design canvas artboard Main.dc.html. Edit the canvas, then re-port.
import BaseV2 from '../layouts/BaseV2.astro';
import projects from '../data/home-projects.json';
const p0 = projects[0];
const total = String(projects.length).padStart(2, '0');
---
<BaseV2 title="Hunter Paramore · Design Engineer" description="Design engineer for consumer apps and design systems. I design the product, then I ship the code.">
  <!-- HERO: one screen = role, contexts, proof, a path to the work and to contact -->
  <section id="top" class="pd-wrap" data-screen-label="Hero">
    <div class="pd-topline">
      <span>Hunter Paramore // Design Engineer</span>
      <span style="color: var(--color-text-faint)">Open to roles · Utah or remote</span>
    </div>
    <h1 class="pd-display" style="margin-top: 36px; font-size: clamp(44px, 7.4vw, 108px)">I learn things by <span class="pd-accent">rebuilding</span> them.</h1>
    <div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 24px 64px; margin-top: 28px; padding-bottom: 8px">
      <div style="max-width: 64ch">
        <p style="font-size: clamp(20px, 2vw, 26px); line-height: 1.3; font-weight: 600; margin: 0">Design engineer for consumer apps and design systems. I design the product, then I ship the code.</p>
        <p class="pd-lede" style="margin-top: 14px; font-size: 17px">13 years, ten of them as the sole designer of Mutual, the #1 LDS dating app. Now building design systems that engineers and AI agents build from.</p>
      </div>
      <div class="pd-btns">
        <a href="#work" class="pd-btn pd-btn--primary">See the work
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a href="mailto:hparamore@gmail.com" class="pd-btn">Email me</a>
        <a href="/resume" class="pd-btn">Résumé</a>
      </div>
    </div>
  </section>

  <!-- SELECTED WORK: pinned panel left, imagery scrolls right -->
  <section id="work" class="pd-wrap" style="padding-top: 40px" data-screen-label="Selected Work">
    <div class="pd-head">
      <span class="pd-kicker pd-kicker--accent">Selected Work</span>
      <span class="pd-head__count"><span data-f="num">{p0.num}</span> / {total}</span>
    </div>
    <div class="home-work">
      <div>
        <div class="home-work__panel" aria-live="polite">
          <div class="home-work__num" aria-hidden="true" data-f="num">{p0.num}</div>
          <div class="home-work__text">
            <div class="pd-kicker" data-f="kicker">{p0.kicker}</div>
            <h2 class="pd-h2" style="font-size: clamp(34px, 4vw, 52px)" data-f="title">{p0.title}</h2>
            <p class="pd-body" style="margin-top: 6px" data-f="desc">{p0.desc}</p>
            <a href={p0.href} class="pd-arrow-link" data-f="link"><span data-f="linkLabel">{p0.linkLabel}</span>
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
            </a>
          </div>
          <div class="pd-cells" style="border-left: 0; grid-template-columns: repeat(auto-fit, minmax(110px, 1fr))" data-f="stats">
            {p0.stats.map((s) => (
              <div style="padding: 18px 16px 18px 0">
                <div class="pd-stat__value" style="font-size: 36px">{s.value}</div>
                <div class="pd-stat__label" style="font-size: 11px">{s.label}</div>
              </div>
            ))}
          </div>
        </div>
      </div>
      <div class="home-work__list">
        {projects.map((p, i) => (
          <a href={p.href} class={'home-work__item' + (i ? ' is-dim' : '')} data-proj={i} style="display: block; text-decoration: none; color: var(--color-text)" target={p.external ? '_blank' : undefined} rel={p.external ? 'noopener' : undefined}>
            <div class="pd-frame">
              <img src={p.img} alt={p.alt} style={'width: 100%; aspect-ratio: ' + p.aspect + '; object-fit: cover'} loading={i ? 'lazy' : 'eager'}>
              <div class="pd-caption"><span>{p.title}</span><span>{p.platform}</span></div>
            </div>
            <div class="home-work__mobile">
              <div class="pd-kicker">{p.kicker}</div>
              <div class="pd-h3">{p.title}</div>
              <p class="pd-body">{p.desc}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
    <div style="border-top: var(--pd-rule); padding: 20px 0; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap">
      <span class="pd-kicker">One more case study, plus a lab of six side builds</span>
      <a href="/work" class="pd-btn">All projects
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
      </a>
    </div>
  </section>

  <!-- PROOF + AVAILABILITY (moved below the work so projects land in the first screen) -->
  <section class="pd-wrap pd-section" data-screen-label="Proof">
    <div class="pd-cells" style="border-left: 0">
      <div style="padding-left: 0">
        <div class="pd-stat__value">13 yrs</div>
        <div class="pd-stat__label">Designing and shipping product</div>
      </div>
      <div>
        <div class="pd-stat__value pd-accent">40K+</div>
        <div class="pd-stat__label">Marriages from Mutual, the app I co-founded</div>
      </div>
      <div>
        <div class="pd-stat__value">#1</div>
        <div class="pd-stat__label">LDS dating app worldwide. Sole designer, ten years</div>
      </div>
      <div style="border-right: 0">
        <div class="pd-stat__value">9</div>
        <div class="pd-stat__label">Apps of my own, designed, built and deployed solo</div>
      </div>
    </div>
    <div style="margin-top: 40px">
    <figure class="pd-testimonial" style="margin: 0">
      <div><div class="pd-kicker pd-kicker--accent">From a client</div><div class="pd-kicker" style="margin-top: 8px">[Pending Carys’s OK to quote]</div></div>
      <div>
        <blockquote>“The submission thing right now is just making our lives so much better. I’m so, so grateful.”</blockquote>
        <figcaption><strong>Carys</strong>, Owner, Utah Valley Bride, on the submissions portal I designed and built for the magazine.</figcaption>
      </div>
    </figure>
    </div>

    <p class="home-avail">
      <span class="home-avail__dot" aria-hidden="true"></span>
      <span><strong style="color: var(--color-text)">Open to new roles.</strong> Design engineer, design systems, or senior product design, in Utah or remote. Also taking select client work through Paramore.Design. <a href="mailto:hparamore@gmail.com" style="color: var(--color-accent-ink); font-weight: 600">Get in touch →</a></span>
    </p>
  </section>

  <!-- HOW I WORK -->
  <section id="how" class="pd-wrap pd-section" data-screen-label="How I Work">
    <div class="pd-head"><span class="pd-kicker pd-kicker--accent">How I Work</span></div>
    <h2 class="pd-h2" style="margin: 32px 0 40px">Four things I do at depth.</h2>
    <div class="pd-cells pd-cells--wide">
      <div>
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M12 2 2 7l10 5 10-5-10-5z"></path><path d="M2 17l10 5 10-5"></path><path d="M2 12l10 5 10-5"></path></svg>
        <h3 class="pd-h3" style="margin-top: 12px">Design Systems</h3>
        <p class="pd-cell__text">Tokens, components, and patterns built as one source of truth, so the product stays consistent at scale.</p>
      </div>
      <div>
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M20.2 6.6 8 18.8 3 20l1.2-5L16.4 2.8a2.2 2.2 0 0 1 3.1 0l.7.7a2.2 2.2 0 0 1 0 3.1z"></path></svg>
        <h3 class="pd-h3" style="margin-top: 12px">Craft</h3>
        <p class="pd-cell__text">The spacing, type, motion, and states most people skip. The details that make a product feel right.</p>
      </div>
      <div>
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>
        <h3 class="pd-h3" style="margin-top: 12px">Mentoring</h3>
        <p class="pd-cell__text">I raise the bar for the people around me, through critique, pairing, and handing over real ownership.</p>
      </div>
      <div>
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.6" stroke-linecap="square" aria-hidden="true"><path d="M13 2 3 14h7l-1 8 11-14h-7l0-6z"></path></svg>
        <h3 class="pd-h3" style="margin-top: 12px">Ship &amp; Learn</h3>
        <p class="pd-cell__text">I’d rather build the real thing and watch how people actually use it than debate it in a doc. Shipping fast is how I find what’s true and fix what isn’t.</p>
      </div>
    </div>
  </section>

  <!-- HOW I LEAD -->
  <section class="pd-wrap pd-section" data-screen-label="How I Lead">
    <div class="pd-text" style="border-top: var(--pd-rule); padding-top: 40px; align-items: start">
      <div>
        <div class="pd-kicker pd-kicker--accent" style="margin-bottom: 20px">How I Lead</div>
        <h2 class="pd-h2">The best designers I work with <span class="pd-accent">get better.</span></h2>
      </div>
      <div class="pd-body">
        <p>Doing it solo for years taught me how a design function should actually run, but I’m always learning from the people around me. When I bring others in, I’m not handing out tasks, I’m working alongside them to build and standardize a system that can grow and influence everyone, making the work better and better. The best part is watching that happen because someone else ran with it.</p>
        <p>My favorite critiques and design reviews are clear, to the point, and aimed at the work itself, focused on one thing: making it better. That kind of honesty only happens when the relationship is there first, so that’s what I build before anything else. Once the trust is real, it’s easier to focus on the work and improve it together, rather than defending it.</p>
      </div>
    </div>
  </section>

  <!-- TOOLKIT -->
  <section class="pd-wrap pd-section" data-screen-label="Toolkit">
    <div class="pd-head"><span class="pd-kicker pd-kicker--accent">The Toolkit</span></div>
    <h2 class="pd-h2" style="margin: 32px 0 40px">What I build with.</h2>
    <div class="pd-cells" style="grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr))">
      <div style="padding: 32px">
        <h3 class="pd-h3">Design</h3>
        <p class="pd-cell__text">Design systems &amp; tokens · UI &amp; interaction · Product &amp; UX strategy · Research &amp; usability testing · Brand &amp; visual identity · Prototyping · Figma (expert)</p>
      </div>
      <div style="padding: 32px">
        <h3 class="pd-h3">Build</h3>
        <p class="pd-cell__text">iOS · Swift / SwiftUI · Android · Kotlin / Compose · Web · React / HTML / CSS · Astro · Supabase · Firebase · Unity / SpriteKit · Claude Code · APIs &amp; agents</p>
      </div>
      <div style="padding: 32px">
        <h3 class="pd-h3">Lead</h3>
        <p class="pd-cell__text">Mentoring &amp; design critique · Cross-functional influence · Design-to-eng collaboration · Roadmapping &amp; prioritization · Stakeholder communication · Hiring &amp; team-building</p>
      </div>
    </div>
  </section>

  <!-- WORKED WITH -->
  <section class="pd-wrap pd-section" data-screen-label="Worked With">
    <div class="pd-kicker pd-kicker--accent" style="margin-bottom: 16px">Worked with // 12+ years across brands you know</div>
    <div class="home-brands">
      <span>Mutual</span><i aria-hidden="true">/</i>
      <span>Ark Dating</span><i aria-hidden="true">/</i>
      <span>Nu Skin</span><i aria-hidden="true">/</i>
      <span>Angel Studios</span><i aria-hidden="true">/</i>
      <span>Tech 9</span><i aria-hidden="true">/</i>
      <span>Stotion</span><i aria-hidden="true">/</i>
      <span>Utah Valley Bride</span><i aria-hidden="true">/</i>
      <span>Paramore Real Estate</span>
    </div>
  </section>

  <!-- ABOUT TEASER -->
  <section class="pd-wrap pd-section pd-section--last" data-screen-label="About">
    <div class="pd-text" style="border-top: var(--pd-rule); padding-top: 40px">
      <div>
        <div class="pd-kicker pd-kicker--accent" style="margin-bottom: 20px">About</div>
        <h2 class="pd-h2">Design-first, but I build.</h2>
      </div>
      <div>
        <p class="pd-lede">I work where design meets product meets engineering: thinking in systems, obsessing over details, and digging into feedback for root causes, not symptoms.</p>
        <a href="/about" class="pd-arrow-link" style="margin-top: 16px">More about me
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CLOSING POSTER -->
  <section id="contact" class="pd-poster" data-screen-label="Contact">
    <div class="pd-poster__inner">
      <div class="pd-kicker" style="margin-bottom: 24px">Get in touch</div>
      <h2 class="pd-poster__title">Let’s make something worth shipping.</h2>
      <p style="margin-top: 28px; max-width: 56ch; font-size: 18px; line-height: 1.5">Whether you’re hiring a designer, building a team, or just want to talk product and craft, I’d like to hear from you.</p>
      <div class="pd-btns" style="margin-top: 36px">
        <a href="mailto:hparamore@gmail.com" class="pd-btn pd-btn--invert">Email me
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
        </a>
        <a href="/resume" class="pd-btn pd-btn--ghost-invert">Résumé</a>
        <a href="/work" class="pd-btn pd-btn--ghost-invert">See the work</a>
      </div>
    </div>
  </section>

  <!-- Section stepper (desktop only) -->
  <div class="home-secnav">
    <button type="button" data-secnav="top" aria-label="Back to top">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="m6 17 6-6 6 6"></path><path d="m6 11 6-6 6 6"></path></svg>
    </button>
    <button type="button" data-secnav="prev" aria-label="Previous section">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="m6 15 6-6 6 6"></path></svg>
    </button>
    <button type="button" data-secnav="next" aria-label="Next section">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="square" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg>
    </button>
  </div>
<script is:inline type="application/json" id="home-projects" set:html={JSON.stringify(projects)}></script>
<script>
  // Pinned panel follows whichever project image is nearest 42% down the viewport.
  const data = JSON.parse(document.getElementById('home-projects').textContent);
  const items = [...document.querySelectorAll('[data-proj]')];
  const f = (k) => document.querySelectorAll(`[data-f="${k}"]`);
  let active = 0;
  const show = (i) => {
    if (i === active) return; active = i; const p = data[i];
    f('num').forEach((el) => (el.textContent = p.num));
    f('kicker').forEach((el) => (el.textContent = p.kicker));
    f('title').forEach((el) => (el.textContent = p.title));
    f('desc').forEach((el) => (el.textContent = p.desc));
    f('linkLabel').forEach((el) => (el.textContent = p.linkLabel));
    f('link').forEach((el) => { el.href = p.href; if (p.external) { el.target = '_blank'; el.rel = 'noopener'; } else { el.removeAttribute('target'); el.removeAttribute('rel'); } });
    f('stats').forEach((el) => {
      el.replaceChildren(...p.stats.map((s) => {
        const c = document.createElement('div'); c.style.padding = '18px 16px 18px 0';
        const v = document.createElement('div'); v.className = 'pd-stat__value'; v.style.fontSize = '36px'; v.textContent = s.value;
        const l = document.createElement('div'); l.className = 'pd-stat__label'; l.style.fontSize = '11px'; l.textContent = s.label;
        c.append(v, l); return c;
      }));
    });
    items.forEach((el, j) => el.classList.toggle('is-dim', j !== i));
  };
  const onScroll = () => {
    const mid = innerHeight * 0.42; let best = 0, bestD = Infinity;
    items.forEach((el, i) => { const r = el.getBoundingClientRect(); const d = Math.abs(r.top + r.height / 2 - mid); if (d < bestD) { bestD = d; best = i; } });
    show(best);
  };
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
  // Section stepper.
  const go = (dir) => {
    const tops = [...document.querySelectorAll('[data-screen-label], [data-proj]')].map((el) => el.getBoundingClientRect().top + scrollY - 90).sort((a, b) => a - b);
    const t = dir > 0 ? tops.find((v) => v > scrollY + 10) : [...tops].reverse().find((v) => v < scrollY - 10);
    if (t !== undefined) scrollTo({ top: Math.max(0, t), behavior: 'smooth' });
  };
  document.querySelector('[data-secnav="top"]')?.addEventListener('click', () => scrollTo({ top: 0, behavior: 'smooth' }));
  document.querySelector('[data-secnav="prev"]')?.addEventListener('click', () => go(-1));
  document.querySelector('[data-secnav="next"]')?.addEventListener('click', () => go(1));
</script>
</BaseV2>

<style is:global>
html{scroll-behavior:smooth}
</style>
