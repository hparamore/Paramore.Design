---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title={"Hunter Paramore · Product Designer · Paramore.Design"}
  description={"Hunter Paramore, product designer with 12 years owning the whole surface: design systems, craft, and the code to ship it. Co-founder and sole designer of Mutual."}
>
<!-- Hero -->
  <section class="hero section home-hero">
    <div class="container">
      <div class="hero__content">
        <span class="label hero__label">Hunter Paramore · Product Designer</span>
        <h1 class="display-xl hero__title">
          I learn things by<br><span class="accent-text">rebuilding</span> them.
        </h1>
        <p class="hero__subtitle">
          I&rsquo;m Hunter, a product designer with twelve years of understanding things by taking
          them apart. I work the same way on the things I ship, watching how people actually use
          them, learning from the feedback and the analytics, and reworking whatever isn&rsquo;t
          right until I understand <em>why</em>. Usually the only designer in the room.
        </p>
        <p class="hero__subtitle hero__subtitle--closer">
          Most of that on Mutual, the #1 LDS dating app I co-founded and designed. It&rsquo;s helped
          40,000+ couples get married, which still amazes me. Lately I&rsquo;m deep in design systems
          and AI, sharing what I learn as I go.
        </p>
        <div class="hero__cta">
          <a href="/work" class="btn btn--primary">
            See the work <span class="btn__arrow">&rarr;</span>
          </a>
          <a href="#how-i-work" class="btn btn--secondary">How I work</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Selected Work -->
  <section class="section" aria-labelledby="work-heading">
    <div class="container">
      <div class="section-header" style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-md);">
        <div>
          <span class="label">Selected Work</span>
          <h2 id="work-heading" style="margin-top: var(--space-sm);">A few things I&rsquo;ve built.</h2>
        </div>
        <a href="/work" class="btn btn--ghost">All Projects <span class="btn__arrow">&rarr;</span></a>
      </div>

      <div class="project-grid section-content">

        {projects.filter((p) => p.data.onHome).map((p) => <ProjectCard project={p.data} />)}

      </div>
    </div>
  </section>

  <!-- Capabilities glimpse -->
  <section class="section" id="how-i-work" aria-labelledby="caps-heading">
    <div class="container">
      <span class="label">How I Work</span>
      <h2 id="caps-heading" style="margin-top: var(--space-sm);">Four things I do at depth.</h2>

      <div class="home-caps">
        <div class="home-cap">
          <span class="home-cap__marker" aria-hidden="true">//</span>
          <h3 class="home-cap__name">Design Systems</h3>
          <p class="home-cap__desc">Tokens, components, and patterns built as one source of truth, so the product stays consistent at scale.</p>
        </div>
        <div class="home-cap">
          <span class="home-cap__marker" aria-hidden="true">//</span>
          <h3 class="home-cap__name">Craft</h3>
          <p class="home-cap__desc">The spacing, type, motion, and states most people skip. The details that make a product feel right.</p>
        </div>
        <div class="home-cap">
          <span class="home-cap__marker" aria-hidden="true">//</span>
          <h3 class="home-cap__name">Mentoring</h3>
          <p class="home-cap__desc">I raise the bar for the people around me, through critique, pairing, and handing over real ownership.</p>
        </div>
        <div class="home-cap">
          <span class="home-cap__marker" aria-hidden="true">//</span>
          <h3 class="home-cap__name">Ship &amp; Learn</h3>
          <p class="home-cap__desc">I&rsquo;d rather build the real thing and watch how people actually use it than debate it in a doc. Shipping fast is how I find what&rsquo;s true and fix what isn&rsquo;t.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- How I Lead -->
  <section class="section" aria-labelledby="lead-heading">
    <div class="container">
      <div class="home-callout">
        <div class="home-callout__head">
          <span class="label">How I lead</span>
          <p class="home-callout__quote" id="lead-heading">The best designers I work with <span class="accent">get better.</span></p>
        </div>
        <div class="home-callout__body">
          <p>
            Doing it solo for years taught me how a design function should actually run, but I&rsquo;m
            always learning from the people around me. When I bring others in, I&rsquo;m not handing out
            tasks, I&rsquo;m working alongside them to build and standardize a system that can grow and
            influence everyone, making the work better and better. The best part is watching that happen
            because someone else ran with it.
          </p>
          <p>
            My favorite critiques and design reviews are clear, to the point, and aimed at the work
            itself, focused on one thing: making it better. That kind of honesty only happens when the
            relationship is there first, so that&rsquo;s what I build before anything else. Once the trust
            is real, it&rsquo;s easier to focus on the work and improve it together, rather than defending it.
          </p>
        </div>
      </div>

      <!-- PLACEHOLDER HIDDEN (2026-06-27): real recommendation needed before un-commenting.
           Need: one-sentence quote from a manager/peer/mentee about craft, systems thinking,
           or team impact + Name, Role, Company. LinkedIn recommendations work well here.
      <figure class="home-pullquote">
        <blockquote>&ldquo;[Drop in a real quote from a manager, peer, or someone you mentored, one
          sentence about your craft, your systems thinking, or your impact on the team.]&rdquo;</blockquote>
        <cite>[Name, Role, Company]</cite>
      </figure>
      -->
      <!-- /PLACEHOLDER HIDDEN -->
    </div>
  </section>

  <!-- Toolkit -->
  <section class="section" aria-labelledby="toolkit-heading">
    <div class="container">
      <span class="label">The Toolkit</span>
      <h2 id="toolkit-heading" style="margin-top: var(--space-sm);">What I build with.</h2>
      <div class="home-toolkit">
        <div class="home-toolkit__col">
          <h4>Design</h4>
          <ul>
            <li>Design systems &amp; tokens</li>
            <li>UI &amp; interaction design</li>
            <li>Product &amp; UX strategy</li>
            <li>Research &amp; usability testing</li>
            <li>Brand &amp; visual identity</li>
            <li>Prototyping · Figma (expert)</li>
          </ul>
        </div>
        <div class="home-toolkit__col">
          <h4>Build</h4>
          <ul>
            <li>iOS · Swift / SwiftUI</li>
            <li>Android · Kotlin / Compose</li>
            <li>Web · React / HTML / CSS</li>
            <li>Firebase / Cloud Functions</li>
            <li>Games · Unity / SpriteKit</li>
            <li>AI · Claude Code · APIs · agents</li>
          </ul>
        </div>
        <div class="home-toolkit__col">
          <h4>Lead</h4>
          <ul>
            <li>Mentoring &amp; design critique</li>
            <li>Cross-functional influence</li>
            <li>Design-to-eng collaboration</li>
            <li>Roadmapping &amp; prioritization</li>
            <li>Stakeholder communication</li>
            <li>Hiring &amp; team-building</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Worked-with strip -->
  <section class="section home-brands" aria-labelledby="brands-heading">
    <div class="container" style="text-align: center;">
      <span class="label">Worked With</span>
      <h2 id="brands-heading" style="margin-top: var(--space-sm); font-size: var(--text-2xl);">12+ years across brands you know.</h2>
      <div class="home-brands__logos">
        <span class="home-brands__logo">Mutual</span>
        <span class="home-brands__logo">Ark Dating</span>
        <span class="home-brands__logo">Nu Skin</span>
        <span class="home-brands__logo">Angel Studios</span>
        <span class="home-brands__logo">Tech 9</span>
        <span class="home-brands__logo">Stotion</span>
        <span class="home-brands__logo">Paramore Real Estate</span>
      </div>
    </div>
  </section>

  <!-- About teaser -->
  <section class="section" aria-labelledby="about-heading">
    <div class="container">
      <span class="label">About</span>
      <h2 id="about-heading" style="margin-top: var(--space-sm); margin-bottom: var(--space-lg);">Design-first, but I build.</h2>
      <p class="home-about__text">
        I studied art with an emphasis on design and have spent my career in the space where{' '}
        <strong>design meets product meets engineering</strong>. I think in systems, obsess over the
        details that make a product feel right, and dig into user feedback to find root causes, not
        just symptoms. Whether embedded on a team, working directly with a founder, or building
        something of my own, I bring the same thing: a drive to make the product better and the
        range to do whatever it takes to get there.
      </p>
      <div style="margin-top: var(--space-xl);">
        <a href="/about" class="btn btn--ghost">More about me <span class="btn__arrow">&rarr;</span></a>
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="home-closing" id="contact">
    <div class="container container--narrow">
      <span class="label">Get In Touch</span>
      <h2 class="display-lg" style="margin-top: var(--space-md);">
        Let&rsquo;s make something <span class="accent-text">worth shipping.</span>
      </h2>
      <p>
        Whether you&rsquo;re hiring a designer, building a team, or just want to talk product and
        craft, I&rsquo;d like to hear from you.
      </p>
      <div class="hero__cta" style="justify-content: center;">
        <a href="mailto:hparamore@gmail.com" class="btn btn--primary">
          Email Me <span class="btn__arrow">&rarr;</span>
        </a>
        <a href="/work" class="btn btn--secondary">See the work</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
</Base>

<style is:global>
    /* ---------- Hero: hard-left, wide headline, momentum into work ---------- */
    /* The global .hero is display:flex, which made its .container shrink-wrap and
       center (the "stacked + floating" feel). Fill the container so the hero
       left-aligns to the page like every other section. */
    .home-hero .container { width: 100%; }
    .home-hero { padding-top: calc(var(--space-4xl) + 16px); padding-bottom: var(--space-lg); }
    .home-hero .hero__content { max-width: 1080px; }
    .home-hero .hero__title {
      max-width: none;
      font-size: clamp(var(--text-4xl), 6.6vw, var(--text-6xl));
    }
    .home-hero .hero__subtitle { max-width: 64ch; text-wrap: pretty; }
    .home-hero .accent-text { color: var(--color-accent); }
    /* Pull Selected Work up so it peeks into the hero, momentum, not a tall stack */
    .home-hero + .section { padding-top: var(--space-xl); }

    /* ---------- Capabilities: asymmetric / broken grid ----------
       Four parallel capabilities laid on a 12-col grid with deliberately uneven
       spans, type scale, and vertical offsets. No 01-04 numbers, no identical
       boxes. The orange "//" marker echoes the brand's label-separator motif.
       The irregularity is the point: it reads "designed", not templated. */
    .home-caps {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--space-2xl);
      row-gap: var(--space-4xl);
      margin-top: var(--space-3xl);
    }
    .home-cap__marker {
      display: block;
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      line-height: 1;
      letter-spacing: var(--tracking-display);
      color: var(--color-accent);
      margin-bottom: var(--space-sm);
    }
    .home-cap__name {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      text-transform: uppercase;
      letter-spacing: var(--tracking-display);
      line-height: 0.9;
      text-wrap: balance;
      margin-bottom: var(--space-md);
    }
    .home-cap__desc {
      font-size: var(--text-md);
      color: var(--color-text-secondary);
      line-height: 1.55;
      max-width: 46ch;
    }

    /* Broken placement: uneven widths + staggered baselines */
    .home-cap:nth-child(1) { grid-column: 1 / 8; }
    .home-cap:nth-child(1) .home-cap__name {
      font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
    }
    .home-cap:nth-child(2) { grid-column: 9 / 13; align-self: end; }
    .home-cap:nth-child(3) { grid-column: 1 / 5; }
    .home-cap:nth-child(4) { grid-column: 6 / 13; margin-top: var(--space-2xl); }
    .home-cap:nth-child(4) .home-cap__name {
      font-size: clamp(var(--text-3xl), 4.5vw, var(--text-5xl));
    }
    .home-cap:nth-child(4) .home-cap__desc { max-width: 54ch; }

    /* Tablet: 2-up, gentler offsets */
    @media (max-width: 900px) {
      .home-caps { row-gap: var(--space-3xl); }
      .home-cap:nth-child(1) { grid-column: 1 / 13; }
      .home-cap:nth-child(2) { grid-column: 1 / 7; align-self: auto; }
      .home-cap:nth-child(3) { grid-column: 7 / 13; }
      .home-cap:nth-child(4) { grid-column: 1 / 13; margin-top: 0; }
      .home-cap__name { font-size: var(--text-4xl) !important; }
    }
    /* Mobile: single column */
    @media (max-width: 560px) {
      .home-caps { row-gap: var(--space-2xl); }
      .home-cap { grid-column: 1 / 13 !important; margin-top: 0 !important; }
      .home-cap__name { font-size: var(--text-3xl) !important; }
    }

    /* ---------- Worked-with strip ---------- */
    .home-brands {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border-subtle);
      border-bottom: 1px solid var(--color-border-subtle);
    }
    .home-brands__logos {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2xl);
      align-items: center;
      justify-content: center;
      margin-top: var(--space-xl);
    }
    .home-brands__logo {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
      color: var(--color-text-tertiary);
      transition: color var(--duration-normal) var(--ease-out);
    }
    .home-brands__logo:hover { color: var(--color-text-primary); }

    /* ---------- About teaser ---------- */
    .home-about__text {
      max-width: 62ch;
      font-size: var(--text-lg);
      line-height: 1.6;
      color: var(--color-text-secondary);
    }
    .home-about__text strong { color: var(--color-text-primary); font-weight: 600; }

    /* ---------- How I Lead callout: 3-col (heading 1 / body 2) ---------- */
    .home-callout {
      border: 1px solid var(--color-accent-muted);
      border-radius: var(--radius-xl);
      background:
        linear-gradient(180deg, var(--color-accent-subtle), transparent 70%),
        var(--color-surface);
      padding: var(--space-4xl) var(--space-3xl);
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: var(--space-3xl);
      align-items: start;
    }
    .home-callout__head .label {
      display: block;
      font-size: var(--text-base);
      margin-bottom: var(--space-xl);
    }
    .home-callout__quote {
      font-family: var(--font-display);
      font-size: clamp(var(--text-4xl), 3.6vw, var(--text-5xl));
      line-height: 0.98;
      letter-spacing: var(--tracking-display);
      text-transform: uppercase;
      text-wrap: balance;
      margin: 0;
    }
    .home-callout__quote .accent { color: var(--color-accent); }
    .home-callout__body p {
      font-size: var(--text-lg);
      line-height: 1.65;
      color: var(--color-text-secondary);
    }
    .home-callout__body p + p { margin-top: var(--space-lg); }
    @media (max-width: 768px) {
      .home-callout {
        grid-template-columns: 1fr;
        gap: var(--space-lg);
        padding: var(--space-2xl) var(--space-xl);
      }
    }

    /* ---------- Pull quote / testimonial ----------
       No side-stripe border (the AI tell). An oversized display quote mark in
       the accent carries the emphasis instead. */
    .home-pullquote {
      max-width: 760px;
      margin: var(--space-2xl) auto 0;
      position: relative;
      padding-top: var(--space-lg);
    }
    .home-pullquote::before {
      content: "\201C";
      display: block;
      font-family: var(--font-display);
      font-size: var(--text-6xl);
      line-height: 0.6;
      color: var(--color-accent);
      margin-bottom: var(--space-sm);
    }
    .home-pullquote blockquote {
      font-family: var(--font-body);
      font-size: var(--text-xl);
      font-weight: 500;
      line-height: 1.4;
      color: var(--color-text-primary);
    }
    .home-pullquote cite {
      display: block;
      margin-top: var(--space-md);
      font-style: normal;
      font-size: var(--text-sm);
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
      color: var(--color-text-tertiary);
    }

    /* ---------- Toolkit columns ---------- */
    .home-toolkit {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: var(--space-2xl);
      margin-top: var(--space-2xl);
    }
    .home-toolkit__col h4 {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      letter-spacing: var(--tracking-display);
      text-transform: uppercase;
      color: var(--color-accent);
      margin-bottom: var(--space-md);
    }
    .home-toolkit__col ul { list-style: none; padding: 0; margin: 0; }
    .home-toolkit__col li {
      font-size: var(--text-base);
      color: var(--color-text-secondary);
      padding: var(--space-sm) 0;
      border-bottom: 1px solid var(--color-border-subtle);
    }
    .home-toolkit__col li:last-child { border-bottom: 0; }
    @media (max-width: 768px) {
      .home-toolkit { grid-template-columns: 1fr; gap: var(--space-xl); }
    }

    /* ---------- Closing ---------- */
    .home-closing { text-align: center; padding: var(--space-5xl) var(--content-padding); }
    .home-closing h2 {
      font-size: var(--text-5xl);
      max-width: 18ch;
      margin: 0 auto var(--space-md);
    }
    .home-closing .accent-text { color: var(--color-accent); }
    .home-closing p {
      max-width: 50ch;
      margin: 0 auto var(--space-2xl);
      font-size: var(--text-lg);
      color: var(--color-text-secondary);
    }
    @media (max-width: 768px) { .home-closing h2 { font-size: var(--text-4xl); } }
  </style>
