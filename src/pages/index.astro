---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import HeroFlow from '../components/HeroFlow.astro';
import Base from '../layouts/Base.astro';

// The homepage speaks to small-business owners (2026-10-22), so real client work for
// small businesses leads; everything else keeps its usual order after it.
const clientFirst = ['paramore-real-estate', 'the-tree-service'];
const rank = (id: string) => (clientFirst.includes(id) ? clientFirst.indexOf(id) : clientFirst.length);
const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => rank(a.id) - rank(b.id) || a.data.order - b.data.order);
---

<Base
  title={"Hunter Paramore · AI & Tech Help for Utah Small Businesses · Paramore.Design"}
  description={"Hunter Paramore is the AI and tech guy for Utah small businesses: websites, custom apps, and AI tools that save time and bring in customers. 13 years designing and building apps."}
>
<!-- Hero -->
  <section class="hero section home-hero">
    <div class="container home-hero__grid">
      <div class="hero__content">
        <h1 class="display-xl hero__title">
          Your business&rsquo;s<br><span class="accent-text">AI &amp; tech guy.</span>
        </h1>
        <p class="hero__subtitle">
          I&rsquo;m Hunter. I&rsquo;ve designed and built apps for 13 years, including Mutual,
          which has helped 40,000+ couples get married. Now I help small businesses get past
          dabbling in AI and put it to work, so the busywork takes care of itself.
        </p>
        <div class="hero__cta">
          <a href="mailto:hparamore@gmail.com?subject=Here%27s%20what%27s%20slowing%20us%20down" class="btn btn--primary">
            Tell me what&rsquo;s slowing you down <span class="btn__arrow">&rarr;</span>
          </a>
          <a href="/work" class="btn btn--secondary">See what I&rsquo;ve built</a>
        </div>
      </div>
      <!-- Show, don't tell: one real automation, drawn as it runs -->
      <HeroFlow />
    </div>
  </section>

  <!-- Proof strip: the numbers, scannable, before anything else -->
  <section class="home-proof">
    <div class="container">
      <div class="home-stats">
        <div class="home-stat">
          <div class="home-stat__value">13 yrs</div>
          <div class="home-stat__label">Designing and shipping product.</div>
        </div>
        <div class="home-stat">
          <div class="home-stat__value">40k+</div>
          <div class="home-stat__label">Marriages from Mutual, the app I co-founded.</div>
        </div>
        <div class="home-stat">
          <div class="home-stat__value">#1</div>
          <div class="home-stat__label">LDS dating app worldwide. Sole designer, ten years.</div>
        </div>
        <div class="home-stat">
          <div class="home-stat__value">9</div>
          <div class="home-stat__label">Apps of my own, designed, built and deployed solo.</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Availability: a business owner&apos;s first question is &quot;are you taking clients?&quot; (job search lives on /resume) -->
  <section class="home-avail">
    <div class="container">
      <p class="home-avail__text">
        <span class="home-avail__dot" aria-hidden="true"></span>
        <strong>Taking on new local clients.</strong> You&rsquo;ll work with me directly,
        from the first call to whatever comes next.
        <a href="mailto:hparamore@gmail.com">Get in touch &rarr;</a>
      </p>
    </div>
  </section>

  <!-- Capabilities glimpse -->
  <section class="section" id="how-i-work" aria-labelledby="caps-heading">
    <div class="container">
      <span class="section-label">What I Do</span>
      <h2 id="caps-heading" class="section-title">How I can help.</h2>

      <div class="home-caps">
        <div class="home-cap">
          <span class="home-cap__marker" aria-hidden="true">//</span>
          <h3 class="home-cap__name">AI that saves you time</h3>
          <p class="home-cap__desc">Follow-ups, review replies, social posts, answers for customers after hours. The stuff that eats your week, handled.</p>
        </div>
        <div class="home-cap">
          <span class="home-cap__marker" aria-hidden="true">//</span>
          <h3 class="home-cap__name">Custom apps &amp; tools</h3>
          <p class="home-cap__desc">When off-the-shelf software doesn&rsquo;t fit, I build the thing that does, and it often replaces a few subscriptions.</p>
        </div>
        <div class="home-cap">
          <span class="home-cap__marker" aria-hidden="true">//</span>
          <h3 class="home-cap__name">Websites that bring people in</h3>
          <p class="home-cap__desc">Hours, prices, and booking one tap away on a phone, so people who find you actually walk in.</p>
        </div>
        <div class="home-cap">
          <span class="home-cap__marker" aria-hidden="true">//</span>
          <h3 class="home-cap__name">Someone to call</h3>
          <p class="home-cap__desc">Ongoing help when something breaks, or when you wonder if there&rsquo;s a better way to do it.</p>
        </div>
      </div>

    </div>
  </section>

  <!-- Selected Work -->
  <section class="section" aria-labelledby="work-heading">
    <div class="container">
      <div class="section-header" style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: var(--space-md);">
        <div>
          <span class="section-label">Selected Work</span>
          <h2 id="work-heading" class="section-title">Things I&rsquo;ve built.</h2>
        </div>
        <a href="/work" class="btn btn--ghost">All Projects <span class="btn__arrow">&rarr;</span></a>
      </div>

      <div class="project-grid section-content">

        {projects.filter((p) => p.data.onHome).map((p) => <ProjectCard project={p.data} />)}

      </div>
    </div>
  </section>

  <!-- About teaser -->
  <section class="section" aria-labelledby="about-heading">
    <div class="container">
      <span class="section-label">About</span>
      <h2 id="about-heading" style="margin-bottom: var(--space-lg);" class="section-title">You&rsquo;ll work with me.</h2>
      <p class="home-about__text">
        I design and build everything myself, so the person you talk to is the person doing the
        work. I look at your business the way your customers do, find what&rsquo;s getting in
        their way, and fix that first. A local shop gets <strong>the same care I
        put into apps</strong> used by thousands of people.
      </p>
      <div style="margin-top: var(--space-xl);">
        <a href="/about" class="btn btn--ghost">More about me <span class="btn__arrow">&rarr;</span></a>
      </div>
    </div>
  </section>

  <!-- Worked-with strip -->
  <section class="section home-brands" aria-labelledby="brands-heading">
    <div class="container" style="text-align: center;">
      <span class="section-label">Worked With</span>
      <h2 id="brands-heading" class="section-title">12+ years across brands you know.</h2>
      <div class="home-brands__logos">
        <span class="home-brands__logo">Mutual</span>
        <span class="home-brands__logo">Ark Dating</span>
        <span class="home-brands__logo">Nu Skin</span>
        <span class="home-brands__logo">Angel Studios</span>
        <span class="home-brands__logo">Tech 9</span>
        <span class="home-brands__logo">Stotion</span>
        <span class="home-brands__logo">Paramore Real Estate</span>
      </div>
    </div>
  </section>

  <!-- Closing -->
  <section class="home-closing" id="contact">
    <div class="container">
      <span class="section-label">Get In Touch</span>
      <h2 class="section-title">
        What&rsquo;s <span class="accent-text">slowing you down?</span>
      </h2>
      <p>
        Tell me about it, and I&rsquo;ll tell you what I&rsquo;d try first. It&rsquo;s free,
        and I&rsquo;m happy to help.
      </p>
      <div class="hero__cta" style="justify-content: center;">
        <a href="mailto:hparamore@gmail.com?subject=Here%27s%20what%27s%20slowing%20us%20down" class="btn btn--primary">
          Tell me about it <span class="btn__arrow">&rarr;</span>
        </a>
        <a href="/resume" class="btn btn--secondary">Résumé</a>
        <a href="/work" class="btn btn--secondary">See the work</a>
      </div>
    </div>
  </section>

  <!-- Footer -->
</Base>

<style is:global>
    /* ---------- Hero: hard-left, wide headline, momentum into work ---------- */
    /* The global .hero is display:flex, which made its .container shrink-wrap and
       center (the "stacked + floating" feel). Fill the container so the hero
       left-aligns to the page like every other section. */
    .home-hero .container { width: 100%; }
    .home-hero { padding-top: calc(var(--space-4xl) + 16px); padding-bottom: var(--space-lg); }
    .home-hero .hero__content { max-width: 1080px; }
    .home-hero .hero__title {
      max-width: none;
      font-size: clamp(var(--text-4xl), 6.6vw, var(--text-6xl));
    }
    .home-hero .hero__subtitle { max-width: 64ch; text-wrap: pretty; }
    .home-hero .accent-text { color: var(--color-accent); }
    /* Pull Selected Work up so it peeks into the hero, momentum, not a tall stack */
    .home-hero + .section { padding-top: var(--space-xl); }

    /* ---------- Capabilities: asymmetric / broken grid ----------
       Four parallel capabilities laid on a 12-col grid with deliberately uneven
       spans, type scale, and vertical offsets. No 01-04 numbers, no identical
       boxes. The orange "//" marker echoes the brand's label-separator motif.
       The irregularity is the point: it reads "designed", not templated. */
    .home-caps {
      display: grid;
      grid-template-columns: repeat(12, 1fr);
      column-gap: var(--space-2xl);
      row-gap: var(--space-4xl);
      margin-top: var(--space-3xl);
    }
    .home-cap__marker {
      display: block;
      font-family: var(--font-display);
      font-size: var(--text-2xl);
      line-height: 1;
      letter-spacing: var(--tracking-display);
      color: var(--color-accent);
      margin-bottom: var(--space-sm);
    }
    .home-cap__name {
      font-family: var(--font-display);
      font-size: var(--text-3xl);
      text-transform: uppercase;
      letter-spacing: var(--tracking-display);
      line-height: 0.9;
      text-wrap: balance;
      margin-bottom: var(--space-md);
    }
    .home-cap__desc {
      font-size: var(--text-md);
      color: var(--color-text-secondary);
      line-height: 1.55;
      max-width: 46ch;
    }

    /* Broken placement: uneven widths + staggered baselines */
    .home-cap:nth-child(1) { grid-column: 1 / 8; }
    .home-cap:nth-child(1) .home-cap__name {
      font-size: clamp(var(--text-4xl), 6vw, var(--text-6xl));
    }
    .home-cap:nth-child(2) { grid-column: 9 / 13; align-self: end; }
    .home-cap:nth-child(3) { grid-column: 1 / 5; }
    .home-cap:nth-child(4) { grid-column: 6 / 13; margin-top: var(--space-2xl); }
    .home-cap:nth-child(4) .home-cap__name {
      font-size: clamp(var(--text-3xl), 4.5vw, var(--text-5xl));
    }
    .home-cap:nth-child(4) .home-cap__desc { max-width: 54ch; }

    /* Tablet: 2-up, gentler offsets */
    @media (max-width: 900px) {
      .home-caps { row-gap: var(--space-3xl); }
      .home-cap:nth-child(1) { grid-column: 1 / 13; }
      .home-cap:nth-child(2) { grid-column: 1 / 7; align-self: auto; }
      .home-cap:nth-child(3) { grid-column: 7 / 13; }
      .home-cap:nth-child(4) { grid-column: 1 / 13; margin-top: 0; }
      .home-cap__name { font-size: var(--text-4xl) !important; }
    }
    /* Mobile: single column */
    @media (max-width: 560px) {
      /* One column on phones: 12 tracks with 48px gaps were wider than the screen and got clipped */
      .home-caps { row-gap: var(--space-2xl); grid-template-columns: minmax(0, 1fr); column-gap: 0; }
      .home-cap { grid-column: 1 / -1 !important; margin-top: 0 !important; }
      .home-cap__name { font-size: var(--text-3xl) !important; }
    }

    /* ---------- Proof strip ----------
       Sits directly under the hero so the numbers land before any scrolling.
       Four across on desktop, two on tablet, two on phones — never one column,
       because a single stack reads as a list instead of a scoreboard. */
    .home-proof {
      padding-top: var(--space-xl);
      padding-bottom: var(--space-xl);
    }
    .home-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: var(--space-2xl);
      padding: var(--space-2xl) 0;
      border-top: 1px solid var(--color-border-subtle);
      border-bottom: 1px solid var(--color-border-subtle);
    }
    .home-stat__value {
      font-family: var(--font-display);
      font-size: clamp(var(--text-4xl), 4.5vw, var(--text-5xl));
      line-height: 0.95;
      letter-spacing: var(--tracking-display);
      color: var(--color-accent);
      margin-bottom: var(--space-xs);
    }
    .home-stat__label {
      font-size: var(--text-sm);
      line-height: 1.4;
      color: var(--color-text-secondary);
      max-width: 24ch;
    }
    @media (max-width: 900px) {
      .home-stats { grid-template-columns: repeat(2, 1fr); gap: var(--space-xl); }
    }
    @media (max-width: 560px) {
      .home-stats { gap: var(--space-lg); }
      .home-stat__label { font-size: var(--text-xs); }
    }

    /* ---------- Availability ----------
       A single quiet line. It answers "are you even looking?" without turning the
       page into a job board. The dot is the only ornament it gets. */
    .home-avail { padding: var(--space-lg) 0 0; }
    .home-avail__text {
      font-size: var(--text-base);
      color: var(--color-text-secondary);
      line-height: 1.6;
      max-width: 78ch;
    }
    .home-avail__text strong { color: var(--color-text-primary); }
    .home-avail__text a { color: var(--color-accent); }
    .home-avail__dot {
      display: inline-block;
      width: 8px; height: 8px;
      border-radius: 50%;
      background: var(--color-accent);
      margin-right: var(--space-sm);
      vertical-align: middle;
    }

    .home-toolkit__row h4 {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      letter-spacing: var(--tracking-display);
      text-transform: uppercase;
      color: var(--color-accent);
      margin: 0;
    }

    /* ---------- Worked-with strip ---------- */
    .home-brands {
      background: var(--color-surface);
      border-top: 1px solid var(--color-border-subtle);
      border-bottom: 1px solid var(--color-border-subtle);
    }
    .home-brands__logos {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-2xl);
      align-items: center;
      justify-content: center;
      margin-top: var(--space-xl);
    }
    .home-brands__logo {
      font-family: var(--font-display);
      font-size: var(--text-xl);
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
      color: var(--color-text-tertiary);
      transition: color var(--duration-normal) var(--ease-out);
    }
    .home-brands__logo:hover { color: var(--color-text-primary); }

    /* ---------- About teaser ---------- */
    .home-about__text {
      max-width: 62ch;
      font-size: var(--text-lg);
      line-height: 1.6;
      color: var(--color-text-secondary);
    }
    .home-about__text strong { color: var(--color-text-primary); font-weight: 600; }

    /* ---------- How I Lead callout: 3-col (heading 1 / body 2) ---------- */
    .home-callout {
      border: 1px solid var(--color-accent-muted);
      border-radius: var(--radius-xl);
      background:
        linear-gradient(180deg, var(--color-accent-subtle), transparent 70%),
        var(--color-surface);
      padding: var(--space-4xl) var(--space-3xl);
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: var(--space-3xl);
      align-items: start;
    }
    .home-callout__head .label {
      display: block;
      font-size: var(--text-base);
      margin-bottom: var(--space-xl);
    }
    .home-callout__quote {
      font-family: var(--font-display);
      font-size: clamp(var(--text-4xl), 3.6vw, var(--text-5xl));
      line-height: 0.98;
      letter-spacing: var(--tracking-display);
      text-transform: uppercase;
      text-wrap: balance;
      margin: 0;
    }
    .home-callout__quote .accent { color: var(--color-accent); }
    .home-callout__body p {
      font-size: var(--text-lg);
      line-height: 1.65;
      color: var(--color-text-secondary);
    }
    .home-callout__body p + p { margin-top: var(--space-lg); }
    @media (max-width: 768px) {
      .home-callout {
        grid-template-columns: 1fr;
        gap: var(--space-lg);
        padding: var(--space-2xl) var(--space-xl);
      }
    }

    /* ---------- Pull quote / testimonial ----------
       No side-stripe border (the AI tell). An oversized display quote mark in
       the accent carries the emphasis instead. */
    .home-pullquote {
      max-width: 760px;
      margin: var(--space-2xl) auto 0;
      position: relative;
      padding-top: var(--space-lg);
    }
    .home-pullquote::before {
      content: "\201C";
      display: block;
      font-family: var(--font-display);
      font-size: var(--text-6xl);
      line-height: 0.6;
      color: var(--color-accent);
      margin-bottom: var(--space-sm);
    }
    .home-pullquote blockquote {
      font-family: var(--font-body);
      font-size: var(--text-xl);
      font-weight: 500;
      line-height: 1.4;
      color: var(--color-text-primary);
    }
    .home-pullquote cite {
      display: block;
      margin-top: var(--space-md);
      font-style: normal;
      font-size: var(--text-sm);
      letter-spacing: var(--tracking-wide);
      text-transform: uppercase;
      color: var(--color-text-tertiary);
    }

    /* ---------- Toolkit columns ---------- */
    .home-toolkit { margin-top: var(--space-2xl); }
    /* Label left, the list as one flowing line right — a third of the height of the
       old three-column bullet lists, and still every keyword a filter might want. */
    .home-toolkit__row {
      display: grid;
      grid-template-columns: 140px minmax(0, 1fr);
      gap: var(--space-xl);
      padding: var(--space-lg) 0;
      border-top: 1px solid var(--color-border-subtle);
      align-items: baseline;
    }
    .home-toolkit__row:last-child { border-bottom: 1px solid var(--color-border-subtle); }
    .home-toolkit__row p {
      font-size: var(--text-base);
      color: var(--color-text-secondary);
      line-height: 1.6;
    }
    @media (max-width: 700px) {
      .home-toolkit__row { grid-template-columns: 1fr; gap: var(--space-xs); }
    }
    
    
    
    


    /* ---------- Closing ---------- */
    .home-closing { text-align: center; padding: var(--space-3xl) var(--content-padding); }
    .home-closing h2 {
      font-size: var(--text-5xl);
      max-width: 18ch;
      margin: 0 auto var(--space-md);
    }
    .home-closing .accent-text { color: var(--color-accent); }
    .home-closing p {
      max-width: 50ch;
      margin: 0 auto var(--space-2xl);
      font-size: var(--text-lg);
      color: var(--color-text-secondary);
    }
    @media (max-width: 768px) { .home-closing h2 { font-size: var(--text-4xl); } }
  </style>
