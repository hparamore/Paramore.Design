---
import { getCollection } from 'astro:content';
import ProjectCard from '../components/ProjectCard.astro';
import Base from '../layouts/Base.astro';

const projects = (await getCollection('projects'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => a.data.order - b.data.order);
---

<Base
  title={"Work · Paramore.Design"}
  description={"Selected projects by Hunter Paramore, mobile apps, design systems, and digital products."}
  footerMargin
>
<!-- Page Header -->
  <section class="section" style="padding-top: calc(var(--space-4xl) + 80px);">
    <div class="container">
      <span class="label mb-md" style="display: block;">Portfolio</span>
      <h1 class="display-lg">Selected Work</h1>
      <p class="mt-lg" style="max-width: 600px;">
        A collection of projects spanning mobile apps, design systems,
        game design, and digital products.
      </p>
    </div>
  </section>

  <!-- Project Grid -->
  <section class="section--sm">
    <div class="container">
      <div class="project-grid">

        {projects.map((p) => <ProjectCard project={p.data} />)}

      </div>
    </div>
  </section>

  <!-- Footer -->
</Base>
