---
// Ported from the Claude Design canvas artboard Work.dc.html. Edit the canvas, then re-port.
import BaseV2 from '../layouts/BaseV2.astro';
---
<BaseV2 title="Work · Paramore.Design" description="Five case studies and a lab of side builds by Hunter Paramore, design engineer.">
  <section class="pd-wrap" data-screen-label="Header">
    <div class="pd-topline"><span>Portfolio</span><span style="color: var(--color-text-faint)">5 case studies // 6 lab builds</span></div>
    <h1 class="pd-title" style="margin-top: 40px">Selected Work</h1>
    <p class="pd-lede" style="margin: 28px 0 0">Five case studies that show how I think, then a lab of smaller things I designed and shipped myself.</p>
  </section>

  <!-- CASE STUDIES: full write-ups, strongest first -->
  <section class="pd-wrap pd-section" data-screen-label="Case studies">
    <div class="pd-head" style="margin-bottom: 40px"><span class="pd-kicker pd-kicker--accent">Case studies</span><span class="pd-kicker">5 // context, role, decisions, outcome</span></div>

    <a href="/projects/mutual" class="pd-card" style="margin-bottom: 56px">
      <div class="pd-frame"><img src="/assets/projects/mutual/MutualHero-wide.jpg" alt="Mutual app screens" style="aspect-ratio: 2564 / 1275"></div>
      <div style="display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; align-items: baseline">
        <span class="pd-kicker">Founder // 10 Years // Solo Designer</span><span class="pd-tag">Case study</span>
      </div>
      <h2 class="pd-card__title" style="font-size: clamp(32px, 4vw, 56px)">Mutual</h2>
      <p class="pd-card__desc" style="max-width: 70ch">Co-founder and sole founding designer of the #1 LDS dating app. Ten years owning every surface: UI, brand, design system, research. Responsible for 40,000+ marriages and counting.</p>
    </a>

    <div class="pd-cards">
      <a href="/projects/mutual-design-system-case-study" class="pd-card">
        <div class="pd-frame"><img src="/assets/images/projects/MutualDesignSystemHero.jpg" alt="Mutual Design System live token explorer" style="aspect-ratio: 1 / 1"></div>
        <div style="display: flex; justify-content: space-between; gap: 12px"><span class="pd-kicker">Design System // Engineers &amp; AI Agents</span><span class="pd-tag">Case study</span></div>
        <h2 class="pd-card__title">Mutual Design System</h2>
        <p class="pd-card__desc">One semantic token layer, three brands, six themes, exported to Swift and React. Structured so engineers and AI agents can build correct, on-brand, accessible UI from one source.</p>
      </a>
      <a href="/projects/the-tree-service" class="pd-card">
        <div class="pd-frame"><img src="/assets/images/projects/TreeServiceIpad.webp" alt="The Tree Service field tool on iPad" style="aspect-ratio: 1 / 1"></div>
        <div style="display: flex; justify-content: space-between; gap: 12px"><span class="pd-kicker">Client Project // Field Ops &amp; AI</span><span class="pd-tag">Case study</span></div>
        <h2 class="pd-card__title">The Tree Service</h2>
        <p class="pd-card__desc">Field-ops tool that replaced four SaaS subscriptions with one: equipment, fuel, AI-parsed receipts, and crew safety checklists. Built solo in four weeks.</p>
      </a>
      <a href="/projects/tava" class="pd-card">
        <div class="pd-frame"><img src="/assets/projects/tava/hero.jpg" alt="Tava Health post-session check-in screens" style="aspect-ratio: 1 / 1"></div>
        <div style="display: flex; justify-content: space-between; gap: 12px"><span class="pd-kicker">Design Exercise // Product Design</span><span class="pd-tag">Case study</span></div>
        <h2 class="pd-card__title">Tava Health</h2>
        <p class="pd-card__desc">A concept for the moment people quietly stop going to therapy. A post-session check-in that turns a silent exit into a conversation.</p>
      </a>
      <a href="/projects/spnkr" class="pd-card">
        <div class="pd-frame"><img src="/assets/projects/spnkr/hero.jpg" alt="SPNKr game server dashboard" style="aspect-ratio: 1 / 1"></div>
        <div style="display: flex; justify-content: space-between; gap: 12px"><span class="pd-kicker">Personal Work // Design &amp; Build</span><span class="pd-tag">Case study</span></div>
        <h2 class="pd-card__title">SPNKr</h2>
        <p class="pd-card__desc">Replaced a $30/month game server rental with a spare PC running eight games, controllable from Discord. Then redesigned the dashboard out of default AI output, with the art direction enforced by a script.</p>
      </a>
    </div>
  </section>

  <!-- LAB: smaller builds. Real, shipped proof of range; not argued like case studies -->
  <section class="pd-wrap pd-section pd-section--last" data-screen-label="Lab">
    <div class="pd-head" style="margin-bottom: 0"><span class="pd-kicker pd-kicker--accent">Lab</span><span class="pd-kicker">Side builds, designed and shipped solo</span></div>
    <p class="pd-body" style="padding: 24px 0 32px">Smaller things I designed, built, and put into the world. Each one is live; most started as an idea I’d carried for years.</p>
    <div class="pd-lab">
      <a href="https://checkinapp.app" target="_blank" rel="noopener">
        <img src="/assets/projects/checkin/CheckinHero.jpg" alt="Checkin campfire check-in flow">
        <span class="pd-kicker">iOS &amp; Android</span><span class="pd-lab__title">Checkin</span>
        <span class="pd-lab__desc">Friends signal when they can play through campfire check-ins.</span>
      </a>
      <a href="https://github.com/hparamore/screenshot-maker" target="_blank" rel="noopener">
        <img src="/assets/projects/screenshot-maker/hero.jpg" alt="Screenshot Maker device and language variants">
        <span class="pd-kicker">Open source // Web tool</span><span class="pd-lab__title">Screenshot Maker</span>
        <span class="pd-lab__desc">App Store and Play Store screenshots for every device, size and language from one project.</span>
      </a>
      <a href="/projects/keeper">
        <img src="/assets/projects/keeper/hero.jpg" alt="Keeper">
        <span class="pd-kicker">Web app</span><span class="pd-lab__title">Keeper</span>
        <span class="pd-lab__desc">Remember every birthday.</span>
      </a>
      <a href="/projects/kill-the-fish">
        <img src="/assets/projects/kill-the-fish/hero.jpg" alt="Kill The Fish">
        <span class="pd-kicker">Web app // Game</span><span class="pd-lab__title">Kill The Fish</span>
        <span class="pd-lab__desc">A whiteboard game from school, finally built. Pass one device around and finish the fish.</span>
      </a>
      <a href="/projects/paramore-real-estate">
        <img src="/assets/projects/paramore-real-estate/hero.jpg" alt="Paramore Real Estate branding">
        <span class="pd-kicker">Brand // Signage // Web</span><span class="pd-lab__title">Paramore Real Estate</span>
        <span class="pd-lab__desc">Rebranding my father’s business in an orange you can spot from down the street.</span>
      </a>
      <a href="https://www.figma.com/@hparamore" target="_blank" rel="noopener">
        <img src="/assets/images/projects/GameDesignSystem.jpg" alt="Game UI kits in Figma">
        <span class="pd-kicker">Figma community</span><span class="pd-lab__title">Game UI Kits</span>
        <span class="pd-lab__desc">Zelda, Satisfactory and Raid Rush rebuilt as UI kits. The Zelda kit was featured on Figma’s community homepage.</span>
      </a>
    </div>
  </section>
</BaseV2>
