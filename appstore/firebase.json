{
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", "**/.*", "FIREBASE.md", "README.md", "IDEA.md"],
    "headers": [
      {
        "source": "**/*.@(js|css)",
        "headers": [{ "key": "Cache-Control", "value": "max-age=3600" }]
      },
      {
        "source": "assets/**",
        "headers": [{ "key": "Cache-Control", "value": "max-age=86400" }]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  }
}
